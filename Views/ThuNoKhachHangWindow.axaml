<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ShopHoa.Models"
        x:Class="ShopHoa.Views.ThuNoKhachHangWindow"
        Title="Thanh toán công nợ khách hàng"
        Width="560"
        Height="750"
        MinWidth="500"
        MinHeight="660"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7F6">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#263B35"/>
        </Style>
        <Style Selector="Button.cancelButton">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#52645E"/>
            <Setter Property="BorderBrush" Value="#D8E5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style Selector="Button.actionButton">
            <Setter Property="Background" Value="#087F6E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Styles>

    <Border Background="#FFFFFF"
            CornerRadius="16"
            BorderBrush="#D8E5E0"
            BorderThickness="1"
            Margin="12"
            Padding="18">

        <Grid RowDefinitions="*,Auto" RowSpacing="12">

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="12">

                    <!-- TIÊU ĐỀ -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#E6F5F1">
                            <TextBlock Text="💰" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Thanh toán công nợ khách hàng"
                                       FontSize="18" FontWeight="Bold" Foreground="#163F38"/>
                            <TextBlock Text="Ưu tiên phân bổ vào hóa đơn cũ nhất còn nợ"
                                       FontSize="12" Foreground="#61736E"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- TÓM TẮT KHÁCH HÀNG -->
                    <Border Background="#F7FAF9" BorderBrush="#E2ECE8"
                            BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Mã khách hàng" Foreground="#61736E" FontSize="13"/>
                                <TextBlock x:Name="TxtMaKhachHang" Grid.Column="1" FontWeight="SemiBold"
                                           Foreground="#163F38" FontSize="13"/>
                            </Grid>
                            <Border Height="1" Background="#E8F0ED"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Khách hàng" Foreground="#61736E" FontSize="13"/>
                                <TextBlock x:Name="TxtKhachHang" Grid.Column="1" FontWeight="SemiBold"
                                           Foreground="#163F38" FontSize="13"/>
                            </Grid>
                            <Border Height="1" Background="#E8F0ED"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Tổng công nợ hiện tại" Foreground="#61736E" FontSize="13"/>
                                <TextBlock x:Name="TxtConNo" Grid.Column="1" FontWeight="Bold"
                                           Foreground="#D64545" FontSize="14"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Số dư trả trước hiện tại" Foreground="#61736E" FontSize="13"/>
                                <TextBlock x:Name="TxtSoDuTraTruocHienTai" Grid.Column="1" FontWeight="SemiBold"
                                           Foreground="#087F6E" FontSize="13"/>
                            </Grid>
                            <Border Height="1" Background="#E8F0ED"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Công nợ được thanh toán" Foreground="#61736E" FontSize="13"/>
                                <TextBlock x:Name="TxtCongNoDuocThanhToan" Grid.Column="1" FontWeight="SemiBold"
                                           Foreground="#163F38" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Tiền thanh toán dư (trả trước)" Foreground="#61736E" FontSize="13"/>
                                <TextBlock x:Name="TxtTienThanhToanDu" Grid.Column="1" FontWeight="Bold"
                                           Foreground="#087F6E" FontSize="13"/>
                            </Grid>
                            <Border Height="1" Background="#E8F0ED"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Công nợ sau thanh toán" Foreground="#61736E" FontSize="13"/>
                                <TextBlock x:Name="TxtConNoSauThu" Grid.Column="1" FontWeight="Bold"
                                           Foreground="#087F6E" FontSize="14"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Số dư trả trước sau giao dịch" Foreground="#61736E" FontSize="13"/>
                                <TextBlock x:Name="TxtSoDuTraTruocSau" Grid.Column="1" FontWeight="Bold"
                                           Foreground="#087F6E" FontSize="14"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                   <!-- SỐ TIỀN THU -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Số tiền thanh toán" FontWeight="SemiBold"
                                Foreground="#163F38" FontSize="13"/>
                        <TextBox x:Name="TxtSoTienThu"
                                Height="42"
                                Text=""
                                Watermark="Nhập số tiền cần thu"
                                VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- PHƯƠNG THỨC -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Phương thức thanh toán" FontWeight="SemiBold"
                                   Foreground="#163F38" FontSize="13"/>
                        <ComboBox x:Name="CboPhuongThuc" HorizontalAlignment="Stretch" Height="38"/>
                    </StackPanel>

                    <!-- THỜI GIAN -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Thời gian thanh toán" FontWeight="SemiBold"
                                   Foreground="#163F38" FontSize="13"/>
                        <Grid ColumnDefinitions="*,140" ColumnSpacing="8">
                            <DatePicker x:Name="NgayThanhToanPicker"/>
                            <TextBox x:Name="GioThanhToanBox" Grid.Column="1"
                                     Height="38" VerticalContentAlignment="Center" Watermark="HH:mm"/>
                        </Grid>
                    </StackPanel>

                    <!-- MÃ THAM CHIẾU -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Mã tham chiếu / chứng từ" FontWeight="SemiBold"
                                   Foreground="#163F38" FontSize="13"/>
                        <TextBox x:Name="TxtMaThamChieu" MaxLength="150" Height="38"
                                 VerticalContentAlignment="Center"
                                 Watermark="Mã giao dịch ngân hàng hoặc chứng từ (không bắt buộc)"/>
                    </StackPanel>

                    <!-- NGƯỜI THỰC HIỆN -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Người thực hiện" FontWeight="SemiBold"
                                   Foreground="#163F38" FontSize="13"/>
                        <ComboBox x:Name="CboNguoiThu" HorizontalAlignment="Stretch" Height="38">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:SoQuyLuaChonItem">
                                    <TextBlock Text="{Binding HienThi}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- GHI CHÚ -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Ghi chú" FontWeight="SemiBold"
                                   Foreground="#163F38" FontSize="13"/>
                        <TextBox x:Name="TxtGhiChu" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="48" MaxHeight="72"
                                 Watermark="Ghi chú (không bắt buộc)..."/>
                    </StackPanel>

                    <!-- LỖI -->
                    <TextBlock x:Name="TxtLoi" Foreground="#D92D20" FontWeight="SemiBold"
                               FontSize="12" TextWrapping="Wrap" IsVisible="False"/>
                </StackPanel>
            </ScrollViewer>

            <!-- NÚT CỐ ĐỊNH -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2ECE8"
                    BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Button Content="Hủy" Classes="cancelButton" Width="95" Height="42"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="OnCancelClick"/>
                    <Button x:Name="BtnConfirm" Content="✓ Xác nhận thu nợ"
                            Grid.Column="1" Classes="actionButton" Height="42"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="OnConfirmClick"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>