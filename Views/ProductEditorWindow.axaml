<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShopHoa.Views.ProductEditorWindow"
        Width="620"
        Height="760"
        MinWidth="560"
        Title="Sản phẩm"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAF9"
        RequestedThemeVariant="Light">
  <Window.Styles>
    <Style Selector="Window">
      <Setter Property="Background" Value="#F7FAF9"/>
      <Setter Property="Foreground" Value="#263B35"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#263B35"/>
      <Setter Property="BorderBrush" Value="#C9DCD6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Margin" Value="0,5,0,14"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style Selector="TextBox:pointerover">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#263B35"/>
      <Setter Property="BorderBrush" Value="#8CCFC0"/>
    </Style>

    <Style Selector="TextBox:focus">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#263B35"/>
      <Setter Property="BorderBrush" Value="#087F6E"/>
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C9DCD6"/>
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#087F6E"/>
    </Style>

    <Style Selector="TextBox /template/ ScrollViewer#PART_ContentHost">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#263B35"/>
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#344B45"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#263B35"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#263B35"/>
      <Setter Property="BorderBrush" Value="#C9DCD6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,5,0,14"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#087F6E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#087F6E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#056B5D"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#344B45"/>
      <Setter Property="BorderBrush" Value="#C9DCD6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#E8F5F1"/>
      <Setter Property="Foreground" Value="#075C50"/>
      <Setter Property="BorderBrush" Value="#8CCFC0"/>
    </Style>

    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
  </Window.Styles>

  <ScrollViewer>
    <StackPanel Margin="28,24">
      <TextBlock Text="Thông tin sản phẩm" FontSize="23" FontWeight="Bold" Foreground="#163F38" Margin="0,0,0,4"/>
      <TextBlock Text="Nhập thông tin để tạo sản phẩm mới trong kho hàng."
                 Foreground="#6B7D77" FontSize="13" Margin="0,0,0,20"/>

      <TextBlock Classes="label" Text="Mã sản phẩm *"/>
      <TextBox x:Name="MaSanPhamTextBox" Watermark="Ví dụ: SP001"/>

      <TextBlock Classes="label" Text="Tên sản phẩm *"/>
      <TextBox x:Name="TenSanPhamTextBox" Watermark="Tên hoa hoặc phụ kiện"/>

      <TextBlock Classes="label" Text="Mã vạch"/>
      <TextBox x:Name="MaVachTextBox"/>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
        <StackPanel>
          <TextBlock Classes="label" Text="Nhóm sản phẩm"/>
          <ComboBox x:Name="NhomSanPhamComboBox" PlaceholderText="Chọn nhóm hàng"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="label" Text="Đơn vị tính"/>
          <ComboBox x:Name="DonViTinhComboBox" PlaceholderText="Chọn đơn vị"/>
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
        <StackPanel>
          <TextBlock Classes="label" Text="Giá bán"/>
          <TextBox x:Name="GiaBanTextBox" Text="0"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="label" Text="Giá vốn"/>
          <TextBox x:Name="GiaVonTextBox" Text="0"/>
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
        <StackPanel>
          <TextBlock Classes="label" Text="Tồn tối thiểu"/>
          <TextBox x:Name="TonToiThieuTextBox" Text="0"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="label" Text="Tồn tối đa"/>
          <TextBox x:Name="TonToiDaTextBox" Text="0"/>
        </StackPanel>
      </Grid>

      <TextBlock Classes="label" Text="Vị trí kho"/>
      <TextBox x:Name="ViTriKhoTextBox" Watermark="Ví dụ: Kệ A1"/>

      <TextBlock Classes="label" Text="Mô tả"/>
      <TextBox x:Name="MoTaTextBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Watermark="Mô tả sản phẩm"/>

      <TextBlock Classes="label" Text="Ghi chú"/>
      <TextBox x:Name="GhiChuTextBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Watermark="Ghi chú nội bộ"/>

      <StackPanel Orientation="Horizontal" Spacing="28" Margin="0,0,0,18">
        <CheckBox x:Name="DuocBanTrucTiepCheckBox" Content="Được bán trực tiếp" IsChecked="True"/>
        <CheckBox x:Name="DangKinhDoanhCheckBox" Content="Đang kinh doanh" IsChecked="True"/>
      </StackPanel>

      <TextBlock x:Name="ErrorTextBlock" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,4,0,0">
        <Button Classes="secondary" Content="Hủy" Click="CancelButton_OnClick"/>
        <Button Classes="primary" Content="Lưu sản phẩm" Click="SaveButton_OnClick"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
