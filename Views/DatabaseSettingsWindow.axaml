<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShopHoa.ViewModels"
        x:Class="ShopHoa.Views.DatabaseSettingsWindow"
        x:DataType="vm:DatabaseSettingsViewModel"
        Title="Cài đặt kết nối Database"
        Width="620"
        Height="700"
        MinWidth="560"
        MinHeight="620"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">

    <Window.Styles>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#172033"/>
        </Style>

        <Style Selector="TextBox.input">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="TextBox.input:focus">
            <Setter Property="BorderBrush" Value="#0878E8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0878E8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>

    </Window.Styles>


    <Border Margin="18"
            Background="#FFFFFF"
            CornerRadius="16"
            BoxShadow="0 8 30 0 #22000000">

        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->
            <StackPanel Grid.Row="0">

                <StackPanel Orientation="Horizontal">

                    <Border Width="48"
                            Height="48"
                            CornerRadius="12"
                            Background="#EAF4FF">

                        <TextBlock Text="⚙"
                                   FontSize="25"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="14,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Cài đặt kết nối"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Cấu hình máy chủ MariaDB"
                                   FontSize="13"
                                   Foreground="#667085"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </StackPanel>

                <Border Height="1"
                        Background="#EAECF0"
                        Margin="0,24,0,20"/>

            </StackPanel>


            <!-- FORM -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Spacing="8">

                    <!-- SERVER -->
                    <TextBlock Text="Máy chủ"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,2"/>

                    <TextBox Classes="input"
                             Text="{Binding Server}"
                             Watermark="Ví dụ: 192.168.1.100 hoặc domain"/>


                    <!-- PORT -->
                    <TextBlock Text="Cổng"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,13,0,2"/>

                    <TextBox Classes="input"
                             Text="{Binding Port}"
                             Watermark="3306"/>


                    <!-- DATABASE -->
                    <TextBlock Text="Tên Database"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,13,0,2"/>

                    <TextBox Classes="input"
                             Text="{Binding Database}"
                             Watermark="hoa_shop"/>


                    <!-- USER -->
                    <TextBlock Text="Tài khoản Database"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,13,0,2"/>

                    <TextBox Classes="input"
                             Text="{Binding User}"
                             Watermark="Tên tài khoản MariaDB"/>


                    <!-- PASSWORD -->
                    <TextBlock Text="Mật khẩu Database"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,13,0,2"/>

                    <TextBox Classes="input"
                             Text="{Binding Password}"
                             PasswordChar="●"
                             Watermark="Mật khẩu MariaDB"/>


                    <!-- SSL -->
                    <TextBlock Text="SSL Mode"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,13,0,2"/>

                    <ComboBox SelectedValue="{Binding SslMode}"
                              SelectedValueBinding="{Binding}"
                              MinHeight="46">

                        <ComboBoxItem Content="None"/>

                        <ComboBoxItem Content="Preferred"/>

                        <ComboBoxItem Content="Required"/>

                    </ComboBox>


                    <!-- STATUS -->
                    <Border Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,18,0,0">

                        <TextBlock Text="{Binding ThongBao}"
                                   Foreground="#475467"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </Border>

                </StackPanel>

            </ScrollViewer>


            <!-- BUTTONS -->
            <Grid Grid.Row="2"
                  Margin="0,22,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <Button Grid.Column="0"
                        Classes="secondary"
                        Content="ĐÓNG"
                        Command="{Binding DongCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        HorizontalAlignment="Left"/>


                <Button Grid.Column="1"
                        Classes="secondary"
                        Content="🔌  KIỂM TRA KẾT NỐI"
                        Command="{Binding KiemTraKetNoiCommand}"
                        Margin="10,0,10,0"/>


                <Button Grid.Column="2"
                        Classes="primary"
                        Content="💾  LƯU"
                        Command="{Binding LuuCommand}"
                        CommandParameter="{Binding $parent[Window]}"/>

            </Grid>

        </Grid>

    </Border>

</Window>