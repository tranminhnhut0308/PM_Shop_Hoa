<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:ShopHoa.Models"
  xmlns:vm="using:ShopHoa.ViewModels"
  x:Class="ShopHoa.Views.BaoCaoBanHangView"
  x:Name="RootView"
  x:DataType="vm:BaoCaoBanHangViewModel">

  <UserControl.Styles>
    <Style Selector="Border.bcCard">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="#E2ECE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 2 10 0 #14000000" />
    </Style>

    <Style Selector="Border.bcMetric">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="#E2ECE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 1 6 0 #10000000" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="MinWidth" Value="176" />
    </Style>

    <Style Selector="Border.bcRow">
      <Setter Property="Padding" Value="0,8" />
      <Setter Property="BorderBrush" Value="#EEF4F2" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="ProgressBar.bcBar">
      <Setter Property="Height" Value="7" />
      <Setter Property="Foreground" Value="#087F6E" />
      <Setter Property="Background" Value="#EFF5F3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
    </Style>

    <Style Selector="TextBlock.bcSectionTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#164B40" />
    </Style>

    <Style Selector="TextBlock.bcSectionSub">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#61736E" />
    </Style>

    <Style Selector="TextBlock.bcMuted">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#61736E" />
    </Style>

    <Style Selector="TextBlock.bcMetricLabel">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="#61736E" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.bcMetricValue">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#164B40" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style Selector="TextBlock.bcTableHead">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#164B40" />
    </Style>

    <Style Selector="TextBlock.bcTableCell">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#2C3A37" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18" Spacing="14">

      <!-- ============ 1. TIÊU ĐỀ + BỘ LỌC KHOẢNG THỜI GIAN ============ -->
      <Border Classes="bcCard" Padding="16,13">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="BÁO CÁO BÁN HÀNG" FontSize="18" FontWeight="SemiBold"
                Foreground="#164B40" />
              <TextBlock Classes="bcSectionSub" Margin="0,3,0,0" TextWrapping="Wrap"
                Text="Doanh thu, số hóa đơn, top sản phẩm / khách hàng và phương thức thanh toán theo khoảng thời gian" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
              VerticalAlignment="Center" HorizontalAlignment="Right">
              <Button Classes="toolbar-action" Content="Hôm nay"
                Command="{Binding VeHomNayCommand}" />
              <Button Classes="toolbar-action" Content="Hôm qua"
                Command="{Binding VeNgayQuaCommand}" />
              <Button Classes="toolbar-action" Content="Tuần này"
                Command="{Binding VeTuanNayCommand}" />
              <Button Classes="toolbar-action" Content="Tháng này"
                Command="{Binding VeThangNayCommand}" />

              <!-- TÙY CHỌN NGÀY -->
              <Button Classes="toolbar-action" MinWidth="150" Height="32"
                Padding="12,6" VerticalContentAlignment="Center">
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Spacing="8" Width="280">
                      <TextBlock Classes="bcMuted" Text="Từ ngày" />
                      <DatePicker SelectedDate="{Binding TuNgayChon, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
                      <TextBlock Classes="bcMuted" Text="Đến ngày" />
                      <DatePicker SelectedDate="{Binding DenNgayChon, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
                      <Button Content="Áp dụng" HorizontalAlignment="Right"
                        Command="{Binding ApDungTuyChinhCommand}"
                        IsEnabled="{Binding CoKhoangTuyChinh}"
                        Background="#087F6E" Foreground="White" Padding="16,7"
                        CornerRadius="8" FontWeight="SemiBold" BorderThickness="0" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="📅" FontSize="14" VerticalAlignment="Center" />
                  <TextBlock Text="Tùy chọn ngày" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Text="▼" FontSize="9" VerticalAlignment="Center"
                    Foreground="#61736E" />
                </StackPanel>
              </Button>

              <Button Classes="toolbar-action" Content="Làm mới"
                Command="{Binding TaiLaiCommand}" />
              <Button Content="Xuất Excel" Command="{Binding XuatExcelCommand}"
                Background="#087F6E" Foreground="White" Padding="14,7" CornerRadius="8"
                FontWeight="SemiBold" BorderThickness="0" />
            </StackPanel>
          </Grid>

          <Border Height="1" Background="#EEF4F2" />

          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <TextBlock Classes="bcMuted" Text="Khoảng đang xem:"
              VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="bcTableCell" FontWeight="SemiBold"
              VerticalAlignment="Center" Text="{Binding KhoangHienThi}" />
            <TextBlock Grid.Column="2" Classes="bcMuted" VerticalAlignment="Center"
              IsVisible="{Binding DangTai}" Text="Đang tải dữ liệu…" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============ CẢNH BÁO LỖI ============ -->
      <Border IsVisible="{Binding CoLoi}" Background="#FDECEC"
        BorderBrush="#F5C2C2" BorderThickness="1" CornerRadius="10" Padding="14,11">
        <TextBlock Text="{Binding ThongBaoLoi}" TextWrapping="Wrap"
          Foreground="#A32B2B" FontSize="12" />
      </Border>

      <!-- ============ THANH TẢI ============ -->
      <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding DangTai}"
        Foreground="#087F6E" Background="#EAF9F5" BorderThickness="0" />

      <!-- ============ 2. TỔNG HỢP KINH DOANH ============ -->
      <StackPanel Spacing="9">
        <TextBlock Classes="bcSectionTitle"
          Text="2. TỔNG HỢP KINH DOANH — hóa đơn trạng thái HOAN_THANH" />

        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
          <Border Classes="bcMetric">
            <StackPanel>
              <TextBlock Classes="bcMetricLabel" Text="Doanh thu" />
              <TextBlock Classes="bcMetricValue"
                Text="{Binding TongHop.DoanhThuHienThi}" />
              <TextBlock Classes="bcMuted" Margin="0,2,0,0"
                Text="Tổng tiền hàng − giảm giá" />
            </StackPanel>
          </Border>

          <Border Classes="bcMetric">
            <StackPanel>
              <TextBlock Classes="bcMetricLabel" Text="Tổng tiền hàng" />
              <TextBlock Classes="bcMetricValue"
                Text="{Binding TongHop.TongTienHangHienThi}" />
            </StackPanel>
          </Border>

          <Border Classes="bcMetric">
            <StackPanel>
              <TextBlock Classes="bcMetricLabel" Text="Giảm giá" />
              <TextBlock Classes="bcMetricValue"
                Text="{Binding TongHop.GiamGiaHienThi}" />
            </StackPanel>
          </Border>

          <Border Classes="bcMetric">
            <StackPanel>
              <TextBlock Classes="bcMetricLabel" Text="Số hóa đơn" />
              <TextBlock Classes="bcMetricValue"
                Text="{Binding TongHop.SoHoaDonHienThi}" />
            </StackPanel>
          </Border>

          <Border Classes="bcMetric">
            <StackPanel>
              <TextBlock Classes="bcMetricLabel" Text="Giá trị đơn trung bình" />
              <TextBlock Classes="bcMetricValue"
                Text="{Binding TongHop.GiaTriDonTrungBinhHienThi}" />
            </StackPanel>
          </Border>

          <Border Classes="bcMetric">
            <StackPanel>
              <TextBlock Classes="bcMetricLabel" Text="Đã thu" />
              <TextBlock Classes="bcMetricValue" Foreground="#087F6E"
                Text="{Binding TongHop.DaThuHienThi}" />
            </StackPanel>
          </Border>

          <Border Classes="bcMetric">
            <StackPanel>
              <TextBlock Classes="bcMetricLabel" Text="Công nợ" />
              <TextBlock Classes="bcMetricValue" Foreground="#C27803"
                Text="{Binding TongHop.CongNoHienThi}" />
            </StackPanel>
          </Border>
        </WrapPanel>
      </StackPanel>

      <!-- ============ 3. BIỂU ĐỒ DOANH THU ============ -->
      <Border Classes="bcCard" Padding="15">
        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="bcSectionTitle" Text="3. BIỂU ĐỒ DOANH THU" />
              <TextBlock Classes="bcSectionSub" Margin="0,2,0,0" TextWrapping="Wrap"
                Text="Khoảng ≤ 1 ngày hiển thị theo giờ, dài hơn hiển thị theo ngày. Rê chuột lên cột để xem chi tiết." />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="bcMuted" VerticalAlignment="Center"
              Text="{Binding KhoangHienThi}" />
          </Grid>

          <Border Height="1" Background="#EEF4F2" />

          <Grid Height="224">
            <Border VerticalAlignment="Bottom" Height="1" Background="#E2ECE8" />

            <ScrollViewer VerticalScrollBarVisibility="Disabled"
              HorizontalScrollBarVisibility="Auto" Margin="0,0,0,20">
              <ItemsControl ItemsSource="{Binding BieuDoItems}"
                VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:BaoCaoBanHangDiemThoiGian">
                    <StackPanel Width="{Binding BeRongCot}" Margin="2,0"
                      VerticalAlignment="Stretch" ToolTip.Tip="{Binding ToolTip}">
                      <Border Height="{Binding ChieuCaoCot}" CornerRadius="4,4,0,0"
                        Background="#087F6E" VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch" Margin="0,0,0,3" />
                      <TextBlock Text="{Binding NhanXet}" FontSize="9"
                        Foreground="#61736E" HorizontalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <TextBlock Classes="bcMuted" HorizontalAlignment="Center"
            Text="Chưa có hóa đơn nào trong khoảng thời gian đang chọn"
            IsVisible="{Binding !CoBieuDo}" />
        </StackPanel>
      </Border>

      <!-- ============ 4. BẢNG DOANH THU THEO NGÀY ============ -->
      <Border Classes="bcCard" Padding="15">
        <StackPanel Spacing="9">
          <TextBlock Classes="bcSectionTitle" Text="4. BẢNG DOANH THU THEO NGÀY" />
          <TextBlock Classes="bcSectionSub" TextWrapping="Wrap"
            Text="Một dòng cho mỗi ngày có phát sinh. Bấm “Chi tiết” để xem từng hóa đơn của ngày đó." />
          <Border Height="1" Background="#EEF4F2" />

          <ScrollViewer HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel MinWidth="980">
              <Grid ColumnDefinitions="110,70,130,110,130,130,130,100">
                <TextBlock Classes="bcTableHead" Text="Ngày" />
                <TextBlock Grid.Column="1" Classes="bcTableHead" Text="Số HĐ"
                  HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Classes="bcTableHead" Text="Tiền hàng"
                  HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Classes="bcTableHead" Text="Giảm giá"
                  HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Classes="bcTableHead" Text="Doanh thu"
                  HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Classes="bcTableHead" Text="Đã thu"
                  HorizontalAlignment="Right" />
                <TextBlock Grid.Column="6" Classes="bcTableHead" Text="Công nợ"
                  HorizontalAlignment="Right" />
                <TextBlock Grid.Column="7" Classes="bcTableHead" Text=""
                  HorizontalAlignment="Right" />
              </Grid>

              <ItemsControl ItemsSource="{Binding BangItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:BaoCaoBanHangBangRow">
                    <Border Classes="bcRow">
                      <Grid ColumnDefinitions="110,70,130,110,130,130,130,100">
                        <TextBlock Classes="bcTableCell" FontWeight="SemiBold"
                          Text="{Binding ThoiGianHienThi}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="bcTableCell"
                          Text="{Binding SoHoaDonHienThi}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="bcTableCell"
                          Text="{Binding TongTienHangHienThi}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Classes="bcTableCell"
                          Text="{Binding GiamGiaHienThi}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Classes="bcTableCell"
                          FontWeight="SemiBold" Text="{Binding DoanhThuHienThi}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Classes="bcTableCell"
                          Foreground="#087F6E" Text="{Binding DaThuHienThi}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Classes="bcTableCell"
                          Foreground="#C27803" Text="{Binding CongNoHienThi}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="7" Content="Chi tiết" FontSize="11"
                          Padding="9,3" CornerRadius="7" Margin="0,0,0,0"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Command="{Binding ElementName=RootView, Path=DataContext.XemChiTietNgayCommand}"
                          CommandParameter="{Binding ThoiGian}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <TextBlock Classes="bcMuted" HorizontalAlignment="Center" TextWrapping="Wrap"
            Text="Chưa có dữ liệu theo ngày trong khoảng thời gian đang chọn"
            IsVisible="{Binding !CoBang}" />
        </StackPanel>
      </Border>

      <!-- ============ 5. CHI TIẾT HÓA ĐƠN THEO NGÀY ============ -->
      <Border Classes="bcCard" Padding="15" IsVisible="{Binding CoNgayChiTiet}">
        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="bcSectionTitle"
                Text="5. CHI TIẾT HÓA ĐƠN TRONG NGÀY" />
              <TextBlock Classes="bcSectionSub" Margin="0,2,0,0"
                Text="{Binding NgayChiTietHienThi}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="toolbar-action" Content="Đóng"
              Command="{Binding DongChiTietCommand}" VerticalAlignment="Center" />
          </Grid>

          <Border Height="1" Background="#EEF4F2" />

          <ScrollViewer HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel MinWidth="980">
              <Grid ColumnDefinitions="130,150,*,130,110,130,130,130">
                <TextBlock Classes="bcTableHead" Text="Mã hóa đơn" />
                <TextBlock Grid.Column="1" Classes="bcTableHead" Text="Thời gian" />
                <TextBlock Grid.Column="2" Classes="bcTableHead" Text="Khách hàng" />
                <TextBlock Grid.Column="3" Classes="bcTableHead" Text="Tiền hàng"
                  HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Classes="bcTableHead" Text="Giảm giá"
                  HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Classes="bcTableHead" Text="Doanh thu"
                  HorizontalAlignment="Right" />
                <TextBlock Grid.Column="6" Classes="bcTableHead" Text="Đã thu"
                  HorizontalAlignment="Right" />
                <TextBlock Grid.Column="7" Classes="bcTableHead" Text="Còn nợ"
                  HorizontalAlignment="Right" />
              </Grid>

              <ItemsControl ItemsSource="{Binding ChiTietHoaDonList}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:BaoCaoBanHangChiTietHoaDon">
                    <Border Classes="bcRow">
                      <Grid ColumnDefinitions="130,150,*,130,110,130,130,130">
                        <TextBlock Classes="bcTableCell" Text="{Binding MaHoaDon}"
                          VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="bcTableCell"
                          Text="{Binding ThoiGianHienThi}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="bcTableCell"
                          Text="{Binding KhachHang}" TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Classes="bcTableCell"
                          Text="{Binding TongTienHangHienThi}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Classes="bcTableCell"
                          Text="{Binding GiamGiaHienThi}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Classes="bcTableCell"
                          FontWeight="SemiBold" Text="{Binding DoanhThuHienThi}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Classes="bcTableCell"
                          Foreground="#087F6E" Text="{Binding DaThuHienThi}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="7" Classes="bcTableCell"
                          Foreground="#C27803" Text="{Binding CongNoHienThi}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <TextBlock Classes="bcMuted" HorizontalAlignment="Center"
            Text="Không có hóa đơn nào trong ngày này"
            IsVisible="{Binding !CoChiTietHoaDon}" />
        </StackPanel>
      </Border>

      <!-- ============ 6. TOP SẢN PHẨM + TOP KHÁCH HÀNG ============ -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

        <!-- Top sản phẩm -->
        <Border Classes="bcCard" Padding="15">
          <StackPanel Spacing="9">
            <TextBlock Classes="bcSectionTitle" Text="6. TOP 10 SẢN PHẨM BÁN CHẠY" />
            <TextBlock Classes="bcSectionSub" TextWrapping="Wrap"
              Text="Xếp theo số lượng bán, lấy từ dòng chi tiết hóa đơn trong khoảng đang chọn." />
            <Border Height="1" Background="#EEF4F2" />

            <Grid ColumnDefinitions="36,*,90,130">
              <TextBlock Classes="bcTableHead" Text="#" />
              <TextBlock Grid.Column="1" Classes="bcTableHead" Text="Sản phẩm" />
              <TextBlock Grid.Column="2" Classes="bcTableHead" Text="SL bán"
                HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Classes="bcTableHead" Text="Doanh thu"
                HorizontalAlignment="Right" />
            </Grid>

            <ItemsControl ItemsSource="{Binding TopSanPhamItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:BaoCaoBanHangTopSanPham">
                  <Border Classes="bcRow">
                    <Grid ColumnDefinitions="36,*,90,130">
                      <Border Width="22" Height="22" CornerRadius="7" Background="#EAF9F5"
                        VerticalAlignment="Center">
                        <TextBlock Text="{Binding Stt}" FontSize="10.5" Foreground="#087F6E"
                          FontWeight="SemiBold" HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Classes="bcTableCell"
                        Text="{Binding SanPham}" TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="bcTableCell"
                        Text="{Binding SoLuongBanHienThi}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Classes="bcTableCell"
                        FontWeight="SemiBold" Text="{Binding DoanhThuHienThi}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="bcMuted" TextWrapping="Wrap"
              Text="Chưa có sản phẩm nào bán trong khoảng đang chọn"
              IsVisible="{Binding !CoTopSanPham}" />
          </StackPanel>
        </Border>

        <!-- Top khách hàng -->
        <Border Grid.Column="1" Classes="bcCard" Padding="15">
          <StackPanel Spacing="9">
            <TextBlock Classes="bcSectionTitle" Text="7. TOP 10 KHÁCH HÀNG" />
            <TextBlock Classes="bcSectionSub" TextWrapping="Wrap"
              Text="Xếp theo tổng mua. Hóa đơn không gắn hồ sơ gộp thành dòng “Khách lẻ”." />
            <Border Height="1" Background="#EEF4F2" />

            <Grid ColumnDefinitions="36,*,60,130,130">
              <TextBlock Classes="bcTableHead" Text="#" />
              <TextBlock Grid.Column="1" Classes="bcTableHead" Text="Khách hàng" />
              <TextBlock Grid.Column="2" Classes="bcTableHead" Text="Số HĐ"
                HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Classes="bcTableHead" Text="Tổng mua"
                HorizontalAlignment="Right" />
              <TextBlock Grid.Column="4" Classes="bcTableHead" Text="Còn nợ"
                HorizontalAlignment="Right" />
            </Grid>

            <ItemsControl ItemsSource="{Binding TopKhachHangItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:BaoCaoBanHangTopKhachHang">
                  <Border Classes="bcRow">
                    <Grid ColumnDefinitions="36,*,60,130,130">
                      <Border Width="22" Height="22" CornerRadius="7" Background="#EAF9F5"
                        VerticalAlignment="Center">
                        <TextBlock Text="{Binding Stt}" FontSize="10.5" Foreground="#087F6E"
                          FontWeight="SemiBold" HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Classes="bcTableCell"
                        Text="{Binding KhachHang}" TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="bcTableCell"
                        Text="{Binding SoHoaDonHienThi}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Classes="bcTableCell"
                        FontWeight="SemiBold" Text="{Binding TongMuaHienThi}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Classes="bcTableCell" Foreground="#C27803"
                        Text="{Binding CongNoHienThi}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="bcMuted" TextWrapping="Wrap"
              Text="Chưa có khách hàng nào trong khoảng đang chọn"
              IsVisible="{Binding !CoTopKhachHang}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ============ 8. PHƯƠNG THỨC THANH TOÁN ============ -->
      <Border Classes="bcCard" Padding="15">
        <StackPanel Spacing="9">
          <TextBlock Classes="bcSectionTitle" Text="8. DOANH THU THEO PHƯƠNG THỨC THANH TOÁN" />
          <TextBlock Classes="bcSectionSub" TextWrapping="Wrap"
            Text="Lấy từ phiếu thu (phieu_chi) đã hoàn thành trong khoảng đang chọn — là dòng tiền thực, khác với “đã thu” trên hóa đơn." />
          <Border Height="1" Background="#EEF4F2" />

          <Grid ColumnDefinitions="*,70,150,90">
            <TextBlock Classes="bcTableHead" Text="Phương thức" />
            <TextBlock Grid.Column="1" Classes="bcTableHead" Text="Giao dịch"
              HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Classes="bcTableHead" Text="Số tiền"
              HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Classes="bcTableHead" Text="Tỉ lệ"
              HorizontalAlignment="Right" />
          </Grid>

          <ItemsControl ItemsSource="{Binding PhuongThucItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:BaoCaoBanHangPhuongThucRow">
                <Border Classes="bcRow">
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,70,150,90">
                      <TextBlock Classes="bcTableCell" FontWeight="SemiBold"
                        Text="{Binding PhuongThucHienThi}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="bcTableCell"
                        Text="{Binding SoGiaoDichHienThi}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="bcTableCell" FontWeight="SemiBold"
                        Text="{Binding SoTienHienThi}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Classes="bcTableCell"
                        Foreground="#087F6E" Text="{Binding TyLePhanTramHienThi}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Classes="bcBar" Value="{Binding TyLePhanTram, Mode=OneWay}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="bcMuted" TextWrapping="Wrap"
            Text="Chưa có phiếu thu nào trong khoảng thời gian đang chọn"
            IsVisible="{Binding !CoPhuongThuc}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="bcMuted" HorizontalAlignment="Center" TextWrapping="Wrap"
        Text="Số liệu lấy từ database theo khoảng thời gian đang chọn. Bấm “Làm mới” để tải lại." />

    </StackPanel>
  </ScrollViewer>
</UserControl>
