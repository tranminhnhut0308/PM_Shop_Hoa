<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShopHoa.Controls"
    x:Class="ShopHoa.Views.ThanhToanCongNoNhaCungCapWindow"
    Title="Thanh toán công nợ nhà cung cấp"
    Width="560"
    Height="700"
    MinWidth="500"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    Background="#F4F7F6">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#263B35" />
        </Style>
        <Style Selector="Button.cancelButton">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#52645E" />
            <Setter Property="BorderBrush" Value="#D8E5E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="Button.actionButton">
            <Setter Property="Background" Value="#087F6E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </Window.Styles>

    <Border Background="White" CornerRadius="16" BorderBrush="#D8E5E0"
        BorderThickness="1" Margin="12" Padding="24">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
            RowSpacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="42" Height="42" CornerRadius="10" Background="#E6F5F1">
                    <TextBlock Text="💸" FontSize="20"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Thanh toán công nợ nhà cung cấp"
                        FontSize="18" FontWeight="Bold" Foreground="#163F38" />
                    <TextBlock Text="Ưu tiên phân bổ vào phiếu nhập cũ nhất còn nợ"
                        FontSize="12" Foreground="#61736E" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Background="#F7FAF9" BorderBrush="#E2ECE8"
                BorderThickness="1" CornerRadius="12" Padding="14,12">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Mã nhà cung cấp" Foreground="#61736E" FontSize="13" />
                        <TextBlock x:Name="TxtMaNhaCungCap" Grid.Column="1"
                            FontWeight="SemiBold" Foreground="#163F38" FontSize="13" />
                    </Grid>
                    <Border Height="1" Background="#E8F0ED" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Nhà cung cấp" Foreground="#61736E" FontSize="13" />
                        <TextBlock x:Name="TxtNhaCungCap" Grid.Column="1"
                            FontWeight="SemiBold" Foreground="#163F38" FontSize="13" />
                    </Grid>
                    <Border Height="1" Background="#E8F0ED" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Tổng công nợ hiện tại" Foreground="#61736E" FontSize="13" />
                        <TextBlock x:Name="TxtCongNo" Grid.Column="1" FontWeight="Bold"
                            Foreground="#D64545" FontSize="14" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Công nợ sau thanh toán" Foreground="#61736E" FontSize="13" />
                        <TextBlock x:Name="TxtCongNoSau" Grid.Column="1" FontWeight="Bold"
                            Foreground="#087F6E" FontSize="14" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock Text="Số tiền thanh toán" FontWeight="SemiBold"
                    Foreground="#163F38" FontSize="13" />
                <controls:MoneyTextBox x:Name="TienThanhToanBox" />
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="4">
                <TextBlock Text="Thời gian thanh toán" FontWeight="SemiBold"
                    Foreground="#163F38" FontSize="13" />
                <Grid ColumnDefinitions="*,140" ColumnSpacing="8">
                    <DatePicker x:Name="NgayThanhToanPicker" />
                    <TextBox x:Name="GioThanhToanBox" Grid.Column="1"
                        Height="38" VerticalContentAlignment="Center" Watermark="HH:mm" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="4">
                <TextBlock Text="Phương thức thanh toán" FontWeight="SemiBold"
                    Foreground="#163F38" FontSize="13" />
                <ComboBox x:Name="CboPhuongThuc" Height="38" />
            </StackPanel>

            <StackPanel Grid.Row="5" Spacing="4">
                <TextBlock Text="Mã tham chiếu / chứng từ" FontWeight="SemiBold"
                    Foreground="#163F38" FontSize="13" />
                <TextBox x:Name="TxtMaThamChieu" MaxLength="150" Height="38"
                    VerticalContentAlignment="Center" Watermark="Mã giao dịch ngân hàng hoặc chứng từ (không bắt buộc)" />
            </StackPanel>

            <StackPanel Grid.Row="6" Spacing="4">
                <TextBlock Text="Người thực hiện" FontWeight="SemiBold"
                    Foreground="#163F38" FontSize="13" />
                <TextBox x:Name="TxtNguoiThucHien" IsReadOnly="True" Height="38"
                    VerticalContentAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="7" Spacing="4">
                <TextBlock Text="Ghi chú" FontWeight="SemiBold"
                    Foreground="#163F38" FontSize="13" />
                <TextBox x:Name="TxtGhiChu" AcceptsReturn="True" TextWrapping="Wrap"
                    MinHeight="48" MaxHeight="72" Watermark="Ghi chú (không bắt buộc)" />
            </StackPanel>

            <TextBlock Grid.Row="8" x:Name="TxtLoi" Foreground="#D92D20"
                FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" IsVisible="False" />

            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Spacing="10">
                <Button Content="Hủy" Classes="cancelButton" Width="100" Height="40"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnCancelClick" />
                <Button Content="✓ Xác nhận thanh toán" Classes="actionButton" Width="190" Height="40"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnConfirmClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
