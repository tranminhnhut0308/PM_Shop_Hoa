<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShopHoa.Views.ThanhToanCongNoNhaCungCapWindow"
        Title="Thanh toán công nợ nhà cung cấp"
        Width="560"
        Height="700"
        MinWidth="500"
        MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7F6">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#263B35"/>
        </Style>
        <Style Selector="Button.cancelButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#52645E"/>
            <Setter Property="BorderBrush" Value="#D8E5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style Selector="Button.actionButton">
            <Setter Property="Background" Value="#087F6E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Styles>

    <Border Background="White"
            CornerRadius="16"
            BorderBrush="#D8E5E0"
            BorderThickness="1"
            Margin="12"
            Padding="18">

        <Grid RowDefinitions="*,Auto" RowSpacing="12">

            <!-- NỘI DUNG CÓ THỂ CUỘN -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="12">

                    <!-- TIÊU ĐỀ -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#E6F5F1">
                            <TextBlock Text="💸" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Thanh toán công nợ nhà cung cấp"
                                       FontSize="18" FontWeight="Bold" Foreground="#163F38"/>
                            <TextBlock Text="Ưu tiên phân bổ vào phiếu nhập cũ nhất còn nợ"
                                       FontSize="12" Foreground="#61736E"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- THÔNG TIN CÔNG NỢ -->
                    <Border Background="#F7FAF9" BorderBrush="#E2ECE8"
                            BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Mã nhà cung cấp" FontSize="13"/>
                                <TextBlock x:Name="TxtMaNhaCungCap" Grid.Column="1" FontWeight="SemiBold"/>
                            </Grid>
                            <Border Height="1" Background="#E8F0ED"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Nhà cung cấp" FontSize="13"/>
                                <TextBlock x:Name="TxtNhaCungCap" Grid.Column="1" FontWeight="SemiBold"/>
                            </Grid>
                            <Border Height="1" Background="#E8F0ED"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Tổng công nợ hiện tại" FontSize="13"/>
                                <TextBlock x:Name="TxtCongNo" Grid.Column="1" FontWeight="Bold" Foreground="#D64545"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Số dư trả trước hiện tại" FontSize="13"/>
                                <TextBlock x:Name="TxtSoDuTraTruocHienTai" Grid.Column="1" FontWeight="SemiBold" Foreground="#087F6E"/>
                            </Grid>
                            <Border Height="1" Background="#E8F0ED"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Công nợ được thanh toán" FontSize="13"/>
                                <TextBlock x:Name="TxtCongNoDuocThanhToan" Grid.Column="1" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Tiền thanh toán dư (trả trước)" FontSize="13"/>
                                <TextBlock x:Name="TxtTienThanhToanDu" Grid.Column="1" FontWeight="Bold" Foreground="#087F6E"/>
                            </Grid>
                            <Border Height="1" Background="#E8F0ED"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Công nợ sau thanh toán" FontSize="13"/>
                                <TextBlock x:Name="TxtCongNoSau" Grid.Column="1" FontWeight="Bold" Foreground="#087F6E"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Số dư trả trước sau giao dịch" FontSize="13"/>
                                <TextBlock x:Name="TxtSoDuTraTruocSau" Grid.Column="1" FontWeight="Bold" Foreground="#087F6E"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SỐ TIỀN THANH TOÁN -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Số tiền thanh toán" FontWeight="SemiBold" Foreground="#163F38" FontSize="13"/>
                        <TextBox x:Name="TxtSoTienThanhToan"
                                 Height="42"
                                 Text=""
                                 Watermark="Nhập số tiền cần thanh toán"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="Vui lòng tự nhập số tiền cần thanh toán"
                                   FontSize="11" Foreground="#81918B"/>
                    </StackPanel>

                    <!-- THỜI GIAN -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Thời gian thanh toán" FontWeight="SemiBold" FontSize="13"/>
                        <Grid ColumnDefinitions="*,140" ColumnSpacing="8">
                            <DatePicker x:Name="NgayThanhToanPicker"/>
                            <TextBox x:Name="GioThanhToanBox" Grid.Column="1"
                                     Height="38" VerticalContentAlignment="Center" Watermark="HH:mm"/>
                        </Grid>
                    </StackPanel>

                    <!-- PHƯƠNG THỨC -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Phương thức thanh toán" FontWeight="SemiBold" FontSize="13"/>
                        <ComboBox x:Name="CboPhuongThuc" Height="38"/>
                    </StackPanel>

                    <!-- MÃ THAM CHIẾU -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Mã tham chiếu / chứng từ" FontWeight="SemiBold" FontSize="13"/>
                        <TextBox x:Name="TxtMaThamChieu" MaxLength="150" Height="38"
                                 VerticalContentAlignment="Center"
                                 Watermark="Mã giao dịch hoặc chứng từ (không bắt buộc)"/>
                    </StackPanel>

                    <!-- NGƯỜI THỰC HIỆN -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Người thực hiện" FontWeight="SemiBold" FontSize="13"/>
                        <TextBox x:Name="TxtNguoiThucHien" IsReadOnly="True" Height="38"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- GHI CHÚ -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Ghi chú" FontWeight="SemiBold" FontSize="13"/>
                        <TextBox x:Name="TxtGhiChu" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="55" MaxHeight="90"
                                 Watermark="Ghi chú (không bắt buộc)"/>
                    </StackPanel>

                    <!-- LỖI -->
                    <TextBlock x:Name="TxtLoi" Foreground="#D92D20" FontWeight="SemiBold"
                               FontSize="12" TextWrapping="Wrap" IsVisible="False"/>
                </StackPanel>
            </ScrollViewer>

            <!-- NÚT CỐ ĐỊNH PHÍA DƯỚI -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E2ECE8"
                    BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Button Content="Hủy" Classes="cancelButton" Width="95" Height="42"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="OnCancelClick"/>
                    <Button Content="✓ Xác nhận thanh toán" Grid.Column="1" Classes="actionButton"
                            Height="42" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="OnConfirmClick"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>