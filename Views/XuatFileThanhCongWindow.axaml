<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShopHoa.Views.XuatFileThanhCongWindow"
        Title="Xuất file thành công"
        Width="580"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Light"
        Background="#F4F7F6">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#087F6E" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#056B5D" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#263B35" />
      <Setter Property="BorderBrush" Value="#C9DCD6" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#E8F5F1" />
      <Setter Property="BorderBrush" Value="#8CCFC0" />
    </Style>
  </Window.Styles>

  <Border Margin="16"
          Background="#FFFFFF"
          BorderBrush="#D7E7E2"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 4 16 0 #12000000">
    <StackPanel Margin="24" Spacing="16">
      <!-- TIÊU ĐỀ THÀNH CÔNG -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Width="40" Height="40" CornerRadius="20" Background="#EAF9F5"
                VerticalAlignment="Center">
          <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="#087F6E"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="XUẤT FILE THÀNH CÔNG"
                     FontSize="17"
                     FontWeight="Bold"
                     Foreground="#164B40" />
          <TextBlock x:Name="MessageTextBlock"
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="#4F625D"
                     LineHeight="18" />
        </StackPanel>
      </Grid>

      <!-- BẢNG THÔNG TIN CHI TIẾT FILE ĐÃ XUẤT -->
      <Border Background="#F7FAF9"
              BorderBrush="#CFE3DD"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16,14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="140,*" RowSpacing="8">
          <!-- Tên báo cáo -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Loại báo cáo:"
                     FontSize="12" FontWeight="SemiBold" Foreground="#61736E" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TenBaoCaoTextBlock"
                     FontSize="12.5" FontWeight="SemiBold" Foreground="#164B40"
                     TextWrapping="Wrap" VerticalAlignment="Center" />

          <!-- Khoảng thời gian báo cáo -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Khoảng thời gian:"
                     FontSize="12" FontWeight="SemiBold" Foreground="#61736E" VerticalAlignment="Center"
                     x:Name="KhoangThoiGianLabel" />
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="KhoangThoiGianTextBlock"
                     FontSize="12" FontWeight="SemiBold" Foreground="#087F6E"
                     TextWrapping="Wrap" VerticalAlignment="Center" />

          <!-- Tên file -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Tên file:"
                     FontSize="12" FontWeight="SemiBold" Foreground="#61736E" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TenFileTextBlock"
                     FontSize="12.5" FontWeight="Bold" Foreground="#087F6E"
                     TextWrapping="Wrap" VerticalAlignment="Center" />

          <!-- Đường dẫn lưu file -->
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Đường dẫn lưu file:"
                     FontSize="12" FontWeight="SemiBold" Foreground="#61736E" VerticalAlignment="Top" Margin="0,2,0,0" />
          <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PathTextBlock"
                     FontSize="12" Foreground="#263B35"
                     TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center" />

          <!-- Thời gian xuất -->
          <TextBlock Grid.Row="4" Grid.Column="0" Text="Thời điểm xuất:"
                     FontSize="12" FontWeight="SemiBold" Foreground="#61736E" VerticalAlignment="Center" />
          <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ThoiGianXuatTextBlock"
                     FontSize="12" Foreground="#334D46" VerticalAlignment="Center" />

          <!-- Số lượng dòng dữ liệu -->
          <TextBlock Grid.Row="5" Grid.Column="0" Text="Số dòng dữ liệu:"
                     FontSize="12" FontWeight="SemiBold" Foreground="#61736E"
                     VerticalAlignment="Center" x:Name="SoDongLabel" />
          <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SoDongTextBlock"
                     FontSize="12" FontWeight="SemiBold" Foreground="#164B40"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- HÀNG NÚT THAO TÁC -->
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0">
        <Button Grid.Column="1" Classes="secondary"
                Content="Đóng"
                Click="CloseButton_OnClick" />
        <Button Grid.Column="2" Classes="secondary"
                Content="Mở thư mục chứa file"
                Click="OpenFolderButton_OnClick" />
        <Button Grid.Column="3" Classes="primary"
                Content="Mở file Excel"
                Click="OpenFileButton_OnClick" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
