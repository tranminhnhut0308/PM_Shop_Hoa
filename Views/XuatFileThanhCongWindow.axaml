<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShopHoa.Views.XuatFileThanhCongWindow"
        Title="Xuất file thành công"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Light"
        Background="#F5F8F7">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#087F6E" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#056B5D" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#263B35" />
      <Setter Property="BorderBrush" Value="#C9DCD6" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#E8F5F1" />
      <Setter Property="BorderBrush" Value="#8CCFC0" />
    </Style>
  </Window.Styles>

  <Border Margin="16"
          Background="#FFFFFF"
          BorderBrush="#D7E7E2"
          BorderThickness="1"
          CornerRadius="14">
    <StackPanel Margin="24" Spacing="18">
      <StackPanel Spacing="6">
        <TextBlock Text="Xuất file thành công"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#163F38" />
        <TextBlock x:Name="MessageTextBlock"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Foreground="#4F625D"
                   LineHeight="22" />
      </StackPanel>

      <Border Background="#F0F8F5"
              BorderBrush="#CFE3DD"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16,13">
        <StackPanel Spacing="5">
          <TextBlock Text="Đường dẫn file"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#164B40" />
          <TextBlock x:Name="PathTextBlock"
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="#263B35"
                     LineHeight="20" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <Button Classes="secondary"
                Content="Đóng"
                Click="CloseButton_OnClick" />
        <Button Classes="secondary"
                Content="Mở thư mục chứa file"
                Click="OpenFolderButton_OnClick" />
        <Button Classes="primary"
                Content="Mở file"
                Click="OpenFileButton_OnClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
