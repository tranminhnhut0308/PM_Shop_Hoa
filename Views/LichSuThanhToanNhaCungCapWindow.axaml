<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ShopHoa.Models"
    x:Class="ShopHoa.Views.LichSuThanhToanNhaCungCapWindow"
    x:CompileBindings="False"
    Title="Lịch sử thanh toán công nợ nhà cung cấp"
    Width="1450"
    Height="760"
    MinWidth="1050"
    MinHeight="600"
    WindowStartupLocation="CenterOwner"
    Background="#F4F7F6">

    <Window.Resources>
        <x:Double x:Key="DatePickerThemeMinWidth">0</x:Double>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="CalendarDatePicker">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="38" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ Button#PART_FlyoutButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E5E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF3F1" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF5F2" />
            <Setter Property="Foreground" Value="#31534B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="SeparatorBrush" Value="#D8E5E0" />
        </Style>
        <Style Selector="Button.quickFilter">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Background" Value="#F3F8F6" />
            <Setter Property="Foreground" Value="#31534B" />
            <Setter Property="BorderBrush" Value="#D8E5E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
    </Window.Styles>

    <Border Background="White" Margin="14" Padding="20"
        CornerRadius="14" BorderBrush="#D8E5E0" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
            <!-- TIÊU ĐỀ & NÚT XUẤT EXCEL -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Lịch sử thanh toán nhà cung cấp" FontSize="21"
                        FontWeight="Bold" Foreground="#163F38" />
                    <TextBlock x:Name="TxtNhaCungCap" Margin="0,4,0,0"
                        FontSize="13" Foreground="#61736E" />
                </StackPanel>
                <Button Grid.Column="1" Content="Xuất Excel" Padding="16,9"
                    CornerRadius="8" Background="#087F6E" Foreground="White"
                    BorderThickness="0" Click="OnExportClick" />
            </Grid>

            <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                <Button Content="Hôm nay" Tag="today" Classes="quickFilter" Click="OnQuickDateClick" />
                <Button Content="Hôm qua" Tag="yesterday" Classes="quickFilter" Click="OnQuickDateClick" />
                <Button Content="7 ngày qua" Tag="last7" Classes="quickFilter" Click="OnQuickDateClick" />
                <Button Content="30 ngày qua" Tag="last30" Classes="quickFilter" Click="OnQuickDateClick" />
                <Button Content="Tháng này" Tag="thisMonth" Classes="quickFilter" Click="OnQuickDateClick" />
                <Button Content="Tháng trước" Tag="lastMonth" Classes="quickFilter" Click="OnQuickDateClick" />
                <Button Content="Tùy chỉnh" Tag="custom" Classes="quickFilter" Click="OnQuickDateClick" />
            </WrapPanel>

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto,*,Auto"
                ColumnSpacing="10" RowSpacing="7">
                <TextBlock Text="Nhà cung cấp" VerticalAlignment="Center" Foreground="#263B35" />
                <ComboBox x:Name="CboNhaCungCap"
                    Grid.Column="1"
                    Height="38"
                    HorizontalAlignment="Stretch"
                    SelectedValueBinding="{Binding Id}"
                    SelectionChanged="OnNhaCungCapSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:NhaCungCapThanhToanLuaChon">
                            <TextBlock Text="{Binding TenNhaCungCap}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate x:DataType="models:NhaCungCapThanhToanLuaChon">
                            <TextBlock Text="{Binding TenNhaCungCap}" />
                        </DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="Từ ngày" VerticalAlignment="Center" Foreground="#263B35" />
                <CalendarDatePicker x:Name="TuNgayPicker" Grid.Column="3"
                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                    FirstDayOfWeek="Monday" Watermark="DD/MM/YYYY"
                    SelectedDateChanged="OnDateChanged" />
                <TextBlock Grid.Row="1" Text="Đến ngày" VerticalAlignment="Center" Foreground="#263B35" />
                <CalendarDatePicker x:Name="DenNgayPicker" Grid.Row="1" Grid.Column="1"
                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                    FirstDayOfWeek="Monday" Watermark="DD/MM/YYYY"
                    SelectedDateChanged="OnDateChanged" />
                <TextBox x:Name="TimKiemBox" Grid.Row="1" Grid.Column="3"
                    Watermark="Mã giao dịch, tham chiếu, phương thức, người thực hiện, ghi chú..."
                    VerticalContentAlignment="Center" Height="38" KeyDown="OnSearchKeyDown" />
                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="8">
                    <Button Content="Lọc" Padding="15,8" Background="#087F6E"
                        Foreground="White" CornerRadius="6" Click="OnFilterClick" />
                    <Button Content="Làm mới" Padding="14,8" Background="White"
                        Foreground="#52645E" BorderBrush="#D8E5E0" BorderThickness="1"
                        CornerRadius="6" Click="OnLamMoiClick" />
                </StackPanel>
                <TextBlock x:Name="TxtTrangThai" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                    Foreground="#B42318" FontSize="12" TextWrapping="Wrap" />
            </Grid>

            <!-- CHỈ SỐ TỔNG KẾT -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                <Border Background="#F0F9F6" BorderBrush="#D8EDE6" BorderThickness="1" CornerRadius="9" Padding="12,9">
                    <StackPanel><TextBlock Text="TỔNG SỐ GIAO DỊCH" FontSize="11" Foreground="#61736E" />
                        <TextBlock x:Name="TxtTongGiaoDich" Margin="0,3" FontSize="18" FontWeight="Bold" Foreground="#163F38" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#F0F9F6" BorderBrush="#D8EDE6" BorderThickness="1" CornerRadius="9" Padding="12,9">
                    <StackPanel><TextBlock Text="TỔNG TIỀN ĐÃ THANH TOÁN" FontSize="11" Foreground="#61736E" />
                        <TextBlock x:Name="TxtTongTien" Margin="0,3" FontSize="18" FontWeight="Bold" Foreground="#087F6E" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#F4F7FB" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="9" Padding="12,9">
                    <StackPanel><TextBlock Text="CÔNG NỢ TRƯỚC THANH TOÁN" FontSize="11" Foreground="#61736E" />
                        <TextBlock x:Name="TxtCongNoTruoc" Margin="0,3" FontSize="18" FontWeight="Bold" Foreground="#31534B" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#FFFBEB" BorderBrush="#F5E9C8" BorderThickness="1" CornerRadius="9" Padding="12,9">
                    <StackPanel><TextBlock Text="CÔNG NỢ SAU THANH TOÁN" FontSize="11" Foreground="#61736E" />
                        <TextBlock x:Name="TxtCongNoSau" Margin="0,3" FontSize="18" FontWeight="Bold" Foreground="#8A5A00" /></StackPanel>
                </Border>
            </Grid>

            <!-- DANH SÁCH LỊCH SỬ -->
            <DataGrid Grid.Row="4" x:Name="LichSuGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                BorderBrush="#E2ECE8"
                BorderThickness="1"
                SelectionMode="Single"
                SelectionChanged="OnSelectionChanged"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                DoubleTapped="OnGridDoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã giao dịch" Binding="{Binding MaGiaoDich}" Width="145" />
                    <DataGridTextColumn Header="Ngày giờ" Binding="{Binding ThoiGianText}" Width="140" />
                    <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding TenNhaCungCap}" Width="180" />
                    <DataGridTextColumn Header="Mã NCC" Binding="{Binding MaNhaCungCap}" Width="110" />
                    <DataGridTextColumn Header="Mã tham chiếu" Binding="{Binding MaThamChieuHienThi}" Width="145" />
                    <DataGridTextColumn Header="Nội dung thanh toán" Binding="{Binding NoiDungThanhToan}" Width="220" />
                    <DataGridTemplateColumn Header="Công nợ trước" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CongNoTruocText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Đã thanh toán" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SoTienText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="#087F6E" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Công nợ sau" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CongNoSauText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Phương thức" Binding="{Binding PhuongThucHienThi}" Width="135" />
                    <DataGridTemplateColumn Header="Trạng thái" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Panel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0">
                                    <Border IsVisible="{Binding !DaHuy}"
                                            Background="#ECFDF3" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="Hoàn thành" Foreground="#027A48" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <Border IsVisible="{Binding DaHuy}"
                                            Background="#FEF3F2" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="Đã hủy" Foreground="#B42318" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Panel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Người thực hiện" Binding="{Binding NguoiThucHien}" Width="150" />
                    <DataGridTemplateColumn Header="Thao tác" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Xem chi tiết" Padding="8,5"
                                    Background="#EAF5F2" Foreground="#087F6E"
                                    CornerRadius="6" BorderThickness="0"
                                    Click="OnRowDetailClick" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- THANH THAO TÁC CUỐI TRANG -->
            <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtResultRange" VerticalAlignment="Center"
                        Foreground="#61736E" Margin="0,0,8,0" />
                    <TextBlock Text="Số dòng:" VerticalAlignment="Center" Foreground="#61736E" />
                    <ComboBox x:Name="CboPageSize" Width="76" Height="34"
                        VerticalContentAlignment="Center" SelectionChanged="OnPageSizeChanged" />
                    <Button Content="|‹" ToolTip.Tip="Trang đầu" Click="OnFirstPageClick" />
                    <Button Content="‹" ToolTip.Tip="Trang trước" Click="OnPreviousPageClick" />
                    <TextBlock x:Name="TxtPage" VerticalAlignment="Center" FontWeight="SemiBold"
                        Foreground="#31534B" Margin="4,0" />
                    <Button Content="›" ToolTip.Tip="Trang sau" Click="OnNextPageClick" />
                    <Button Content="›|" ToolTip.Tip="Trang cuối" Click="OnLastPageClick" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnDetail" Content="Xem chi tiết giao dịch" Padding="16,8"
                    Background="#087F6E" Foreground="White" CornerRadius="6"
                    Click="OnDetailClick" IsEnabled="False" />
                <Button Content="Đóng" MinWidth="100" Padding="16,8"
                    Background="#FFFFFF" Foreground="#52645E" BorderBrush="#D8E5E0" BorderThickness="1" CornerRadius="6"
                    Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
