<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:ShopHoa.Models"
  x:Class="ShopHoa.Views.InvoiceWindow"
  x:DataType="models:HoaDonBanHangReceipt"
  Title="Hóa đơn bán hàng"
  Width="700"
  Height="800"
  MinWidth="580"
  MinHeight="620"
  Background="#FFFFFF">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#263B35" />
    </Style>
    <Style Selector="Button.toolbar-primary">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#087F6E" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.toolbar-primary:pointerover">
      <Setter Property="Background" Value="#056B5D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.btn-pay-debt">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.btn-pay-debt:pointerover">
      <Setter Property="Background" Value="#056B5D" />
    </Style>
    <Style Selector="Button.btn-print">
      <Setter Property="Background" Value="#E6F5F1" />
      <Setter Property="Foreground" Value="#087F6E" />
      <Setter Property="BorderBrush" Value="#B2DDD0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.btn-print:pointerover">
      <Setter Property="Background" Value="#D4EDE6" />
      <Setter Property="Foreground" Value="#056B5D" />
    </Style>
    <Style Selector="Button.btn-cancel-invoice">
      <Setter Property="Background" Value="#FEF2F2" />
      <Setter Property="Foreground" Value="#B91C1C" />
      <Setter Property="BorderBrush" Value="#FCA5A5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.btn-cancel-invoice:pointerover">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="Foreground" Value="#991B1B" />
    </Style>
    <Style Selector="Button.btn-close">
      <Setter Property="Background" Value="#F2F4F7" />
      <Setter Property="Foreground" Value="#344054" />
      <Setter Property="BorderBrush" Value="#D0D5DD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.btn-close:pointerover">
      <Setter Property="Background" Value="#E4E7EC" />
    </Style>
  </Window.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" Spacing="10">
      <!-- ĐẦU HÓA ĐƠN: lấy từ Thông tin tiệm trong database, không hard-code -->
      <StackPanel Spacing="3" Margin="0,0,0,4">
        <Image Source="{Binding ThongTinTiem.LogoBitmap}"
          IsVisible="{Binding ThongTinTiem.CoLogo}"
          Height="64" Stretch="Uniform" HorizontalAlignment="Center" />

        <TextBlock Text="{Binding ThongTinTiem.TenTiem}"
          HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
          FontSize="18" FontWeight="Bold" Foreground="#163F38" />

        <TextBlock Text="{Binding ThongTinTiem.DiaChi}"
          IsVisible="{Binding ThongTinTiem.DiaChi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
          HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
          FontSize="12" Foreground="#61736E" />

        <TextBlock Text="{Binding ThongTinTiem.SoDienThoaiHienThi}"
          IsVisible="{Binding ThongTinTiem.SoDienThoaiHienThi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
          HorizontalAlignment="Center" FontSize="12" Foreground="#61736E" />

        <TextBlock Text="{Binding ThongTinTiem.Email}"
          IsVisible="{Binding ThongTinTiem.Email, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
          HorizontalAlignment="Center" FontSize="12" Foreground="#61736E" />

        <TextBlock Text="{Binding ThongTinTiem.WebsiteHienThi}"
          IsVisible="{Binding ThongTinTiem.WebsiteHienThi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
          HorizontalAlignment="Center" FontSize="12" Foreground="#61736E" />

        <TextBlock Text="{Binding ThongTinTiem.MaSoThueHienThi}"
          IsVisible="{Binding ThongTinTiem.MaSoThueHienThi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
          HorizontalAlignment="Center" FontSize="12" Foreground="#61736E" />
      </StackPanel>

      <TextBlock Text="HÓA ĐƠN BÁN HÀNG" HorizontalAlignment="Center" FontSize="22"
        FontWeight="Bold" Foreground="#163F38" />
      <TextBlock Text="{Binding MaHoaDon, StringFormat=Mã hóa đơn: {0}}"
        HorizontalAlignment="Center" Foreground="#61736E" />

      <!-- BANNER HÓA ĐƠN ĐÃ HỦY -->
      <Border IsVisible="{Binding LaHoaDonDaHuy}"
        Background="#FEF2F2"
        BorderBrush="#FCA5A5"
        BorderThickness="1.5"
        CornerRadius="10"
        Padding="14,12"
        Margin="0,6,0,2">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Background="#DC2626" CornerRadius="5" Padding="8,3">
              <TextBlock Text="ĐÃ HỦY" Foreground="White" FontWeight="Bold" FontSize="11.5" />
            </Border>
            <TextBlock Text="Hóa đơn này đã bị hủy — chỉ giữ lại lịch sử để đối soát, không tính vào doanh thu."
              Foreground="#991B1B" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="135,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" Margin="0,4,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Lý do hủy:" FontWeight="SemiBold" Foreground="#7F1D1D" FontSize="12" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LyDoHuy, FallbackValue='Không rõ'}" FontWeight="Bold" Foreground="#991B1B" FontSize="12" TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Người thực hiện:" FontWeight="SemiBold" Foreground="#7F1D1D" FontSize="12" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TenNguoiHuyHienThi}" Foreground="#7F1D1D" FontSize="12" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Thời gian hủy:" FontWeight="SemiBold" Foreground="#7F1D1D" FontSize="12" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ThoiGianHuyText}" Foreground="#7F1D1D" FontSize="12" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Xử lý tồn kho:" FontWeight="SemiBold" Foreground="#7F1D1D" FontSize="12" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TrangThaiGiaoHangKhiHuyHienThi}" Foreground="#7F1D1D" FontSize="12" TextWrapping="Wrap" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Xử lý thanh toán:" FontWeight="SemiBold" Foreground="#7F1D1D" FontSize="12" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PhuongAnTienKhiHuyHienThi}" Foreground="#7F1D1D" FontSize="12" TextWrapping="Wrap" />
          </Grid>

          <!-- Liên kết tới hóa đơn mới thay thế (nếu có) -->
          <Border IsVisible="{Binding CoHoaDonThayThe}"
            Background="#FFFFFF"
            BorderBrush="#FECACA"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,6"
            Margin="0,4,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="🔄 Hóa đơn mới thay thế:" FontWeight="SemiBold" Foreground="#163F38" FontSize="12" />
                <TextBlock Text="{Binding MaHoaDonThayThe}" FontWeight="Bold" Foreground="#087F6E" FontSize="12.5" />
              </StackPanel>
              <Button Grid.Column="1"
                Content="Xem hóa đơn thay thế →"
                Padding="10,4"
                FontSize="11.5"
                CornerRadius="6"
                Background="#E6F5F1"
                Foreground="#087F6E"
                BorderBrush="#B2DDD0"
                BorderThickness="1"
                FontWeight="SemiBold"
                Click="XemHoaDonThayThe_OnClick" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- BANNER HÓA ĐƠN ĐƯỢC TẠO LẠI TỪ HÓA ĐƠN ĐÃ HỦY -->
      <Border IsVisible="{Binding CoHoaDonGoc}"
        Background="#F0FAF7"
        BorderBrush="#B2DDD0"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12,8"
        Margin="0,4,0,2">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="🔗 Hóa đơn thay thế cho hóa đơn gốc đã hủy:" FontSize="12" FontWeight="SemiBold" Foreground="#163F38" />
            <TextBlock Text="{Binding MaHoaDonGoc}" FontSize="12.5" FontWeight="Bold" Foreground="#B91C1C" />
          </StackPanel>
          <Button Grid.Column="1"
            Content="Xem hóa đơn gốc"
            Padding="10,4"
            FontSize="11.5"
            CornerRadius="6"
            Background="White"
            Foreground="#087F6E"
            BorderBrush="#B2DDD0"
            BorderThickness="1"
            FontWeight="SemiBold"
            Click="XemHoaDonGoc_OnClick" />
        </Grid>
      </Border>

      <Border IsVisible="{Binding LaHoaDonTongHop}"
        Background="#FFF7E8" BorderBrush="#F0D9AE" BorderThickness="1"
        CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
        <TextBlock Text="HÓA ĐƠN TỔNG HỢP — file nguồn không có chi tiết hàng hóa. Không thể kiểm tra/in danh sách sản phẩm."
          TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
          FontWeight="SemiBold" Foreground="#7A5210" />
      </Border>
      <TextBlock Text="{Binding ThoiGianBan, StringFormat=Ngày bán: {0:dd/MM/yyyy HH:mm}}"
        HorizontalAlignment="Center" Foreground="#61736E" />
      <TextBlock Text="{Binding MaPhieuThu, StringFormat=Phiếu thu: {0}}"
        IsVisible="{Binding MaPhieuThu, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
        HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#087F6E" Margin="0,2,0,0" />

      <Border BorderBrush="#D8E5E0" BorderThickness="0,0,0,1" Margin="0,8,0,4" />
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Text="Khách hàng:" FontWeight="SemiBold" Foreground="#61736E" />
        <TextBlock Grid.Column="1" Text="{Binding TenKhachHang}" Foreground="#263B35" />
        <TextBlock Grid.Row="1" Text="Số điện thoại:" FontWeight="SemiBold" Foreground="#61736E"
          IsVisible="{Binding HienThiThongTinLienHe}" Margin="0,2,0,0" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SoDienThoaiHienThi}" Foreground="#263B35"
          IsVisible="{Binding HienThiThongTinLienHe}" Margin="0,2,0,0" />
        <TextBlock Grid.Row="2" Text="Địa chỉ:" FontWeight="SemiBold" Foreground="#61736E"
          IsVisible="{Binding HienThiThongTinLienHe}" Margin="0,2,0,0" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiaChiHienThi}" Foreground="#263B35" TextWrapping="Wrap"
          IsVisible="{Binding HienThiThongTinLienHe}" Margin="0,2,0,0" />
        <TextBlock Grid.Row="3" Text="Nhân viên:" FontWeight="SemiBold" Foreground="#61736E" Margin="0,2,0,0" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TenNhanVien}" Foreground="#263B35" Margin="0,2,0,0" />
      </Grid>

      <Grid ColumnDefinitions="*,70,110,130" Margin="0,12,0,0">
        <TextBlock Text="Sản phẩm" FontWeight="Bold" Foreground="#163F38" />
        <TextBlock Grid.Column="1" Text="SL" FontWeight="Bold" HorizontalAlignment="Right"
          Foreground="#163F38" />
        <TextBlock Grid.Column="2" Text="Đơn giá" FontWeight="Bold" HorizontalAlignment="Right"
          Foreground="#163F38" />
        <TextBlock Grid.Column="3" Text="Thành tiền" FontWeight="Bold" HorizontalAlignment="Right"
          Foreground="#163F38" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:HoaDonBanHangReceiptItem">
            <Grid ColumnDefinitions="*,70,110,130" Margin="0,6">
              <TextBlock Text="{Binding TenSanPham}" TextWrapping="Wrap" Foreground="#263B35" />
              <TextBlock Grid.Column="1" Text="{Binding SoLuong, StringFormat={}{0:N0}}"
                HorizontalAlignment="Right" Foreground="#263B35" />
              <TextBlock Grid.Column="2" Text="{Binding DonGia, StringFormat={}{0:N0}}"
                HorizontalAlignment="Right" Foreground="#263B35" />
              <TextBlock Grid.Column="3" Text="{Binding ThanhTien, StringFormat={}{0:N0}}"
                HorizontalAlignment="Right" Foreground="#263B35" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border BorderBrush="#D8E5E0"
        BorderThickness="0,1,0,0"
        Margin="0,8,0,0"
        Padding="0,10,0,0">
        <StackPanel Spacing="7">

          <!-- Tổng tiền hàng -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Tổng tiền hàng"
              Foreground="#61736E" />
            <TextBlock Grid.Column="1"
              Text="{Binding TongTienHang, StringFormat={}{0:N0} đ}"
              Foreground="#263B35" />
          </Grid>

          <!-- Giảm giá -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Giảm giá"
              Foreground="#61736E" />
            <TextBlock Grid.Column="1"
              Text="{Binding GiamGia, StringFormat=- {0:N0} đ}"
              Foreground="#D64545" />
          </Grid>

          <!-- Tổng thanh toán -->
          <Grid ColumnDefinitions="*,Auto"
            Margin="0,3,0,3">
            <TextBlock Text="TỔNG THANH TOÁN"
              FontSize="17"
              FontWeight="Bold"
              Foreground="#163F38" />
            <TextBlock Grid.Column="1"
              Text="{Binding KhachCanTra, StringFormat={}{0:N0} đ}"
              FontSize="17"
              FontWeight="Bold"
              Foreground="#087F6E" />
          </Grid>

          <!-- Tiền khách đưa -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Tiền khách đưa"
              Foreground="#61736E" />
            <TextBlock Grid.Column="1"
              Text="{Binding TienKhachDua, StringFormat={}{0:N0} đ}"
              Foreground="#263B35" />
          </Grid>

          <!-- Đã thanh toán -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Đã thanh toán"
              Foreground="#61736E" />
            <TextBlock Grid.Column="1"
              Text="{Binding KhachDaThanhToan, StringFormat={}{0:N0} đ}"
              Foreground="#263B35" />
          </Grid>

          <!-- Tiền thối -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Tiền thối"
              Foreground="#61736E" />
            <TextBlock Grid.Column="1"
              Text="{Binding TienThoi, StringFormat={}{0:N0} đ}"
              Foreground="#087F6E" />
          </Grid>

          <!-- Công nợ -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Công nợ"
              FontWeight="SemiBold"
              Foreground="#61736E" />
            <TextBlock Grid.Column="1"
              Text="{Binding ConNo, StringFormat={}{0:N0} đ}"
              FontWeight="Bold"
              Foreground="#D64545" />
          </Grid>

        </StackPanel>
      </Border>

      <Border IsVisible="{Binding CoGhiChu}"
        Background="#FFF9ED"
        BorderBrush="#F0E0BB"
        BorderThickness="1"
        CornerRadius="6"
        Padding="10,7"
        Margin="0,10,0,0">
        <StackPanel Spacing="2">
          <TextBlock Text="Ghi chú" FontWeight="SemiBold" FontSize="12" Foreground="#8A5A00" />
          <TextBlock Text="{Binding GhiChu}" TextWrapping="Wrap" FontSize="12"
            Foreground="#263B35" />
        </StackPanel>
      </Border>

      <!-- DANH SÁCH GIAO DỊCH SỔ QUỸ / HOÀN TIỀN / ĐIỀU CHỈNH LIÊN QUAN -->
      <Border IsVisible="{Binding CoGiaoDichLienQuan}"
        Background="#F8FAFC"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12,10"
        Margin="0,10,0,0">
        <StackPanel Spacing="5">
          <TextBlock Text="📋 Giao dịch sổ quỹ, hoàn tiền &amp; điều chỉnh liên quan"
            FontWeight="Bold"
            FontSize="12"
            Foreground="#163F38" />
          <ItemsControl ItemsSource="{Binding GiaoDichLienQuans}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:GiaoDichLienQuanHoaDonItem">
                <TextBlock Text="{Binding HienThiTomTat}"
                  FontSize="11.5"
                  Foreground="#334155"
                  TextWrapping="Wrap"
                  Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding CoCanhBao}"
        Background="#FFF4E5"
        CornerRadius="6"
        Padding="10,7"
        Margin="0,10,0,0">
        <ItemsControl ItemsSource="{Binding CanhBao}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" TextWrapping="Wrap"
                FontSize="11" Foreground="#8A5A00" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock Text="{Binding ThongTinTiem.LoiCamOnHienThi}" HorizontalAlignment="Center"
        TextAlignment="Center" TextWrapping="Wrap" FontStyle="Italic"
        Foreground="#61736E" Margin="0,18,0,8" />

      <TextBlock x:Name="PrintStatus" IsVisible="False" TextWrapping="Wrap"
        HorizontalAlignment="Center" TextAlignment="Center"
        Foreground="#D92D20" FontSize="12" Margin="0,0,0,6" />

      <!-- CÁC NÚT THAO TÁC (Đã gỡ bỏ nút Chỉnh sửa hóa đơn, thay bằng nút Hủy hóa đơn) -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <Button x:Name="ThanhToanCongNoButton" Content="💵 Thanh toán nợ"
          Classes="btn-pay-debt" IsVisible="False"
          Click="ThanhToanCongNoButton_OnClick"
          ToolTip.Tip="Thu công nợ cho hóa đơn này" />
        <Button x:Name="CancelInvoiceButton" Content="🚫 Hủy hóa đơn"
          Classes="btn-cancel-invoice"
          Click="CancelInvoiceButton_OnClick"
          ToolTip.Tip="Hủy hóa đơn này và hoàn tác tồn kho / công nợ / sổ quỹ hoặc tạo lại đơn mới" />
        <Button x:Name="PrintButton" Content="🖨 In" Classes="btn-print"
          Click="PrintButton_OnClick" />
        <Button Content="Đóng" Classes="btn-close"
          Click="CloseButton_OnClick" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
