<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:ShopHoa.Models"
  xmlns:vm="using:ShopHoa.ViewModels"
  xmlns:converters="using:ShopHoa.Converters"
  x:Class="ShopHoa.Views.TongQuanDashboardView"
  x:DataType="vm:DashboardViewModel">

  <UserControl.Resources>
    <converters:TongQuanChonRadioConverter x:Key="TongQuanChonRadio" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.tqCard">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="#E2ECE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 2 10 0 #14000000" />
    </Style>

    <Style Selector="Border.tqMetric">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="#E2ECE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 2 10 0 #14000000" />
      <Setter Property="MinHeight" Value="112" />
    </Style>

    <Style Selector="Border.tqFilter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style Selector="Border.tqRow">
      <Setter Property="Padding" Value="0,8" />
      <Setter Property="BorderBrush" Value="#EEF4F2" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="ProgressBar.tqBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="Foreground" Value="#087F6E" />
      <Setter Property="Background" Value="#EFF5F3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
    </Style>

    <Style Selector="ProgressBar.tqBar /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="ProgressBar.tqLoading /template/ ProgressBar#PART_Indicator">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Button.tqSegment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Height" Value="34" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#4B5D57" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.tqSegment:pointerover">
      <Setter Property="Background" Value="#E9F1EE" />
    </Style>

    <Style Selector="Button.tqSegment.active">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="BorderBrush" Value="#087F6E" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.tqSegment.active:pointerover">
      <Setter Property="Background" Value="#06695A" />
    </Style>

    <Style Selector="Button.tqViewSegment">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#4B5D57" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.tqViewSegment:pointerover">
      <Setter Property="Background" Value="#F1F8F6" />
      <Setter Property="BorderBrush" Value="#A7C9BE" />
    </Style>

    <Style Selector="Button.tqViewSegment.active">
      <Setter Property="Background" Value="#EAF9F5" />
      <Setter Property="BorderBrush" Value="#087F6E" />
      <Setter Property="Foreground" Value="#087F6E" />
    </Style>

    <Style Selector="Button.tqDateButton">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D5E3DF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Foreground" Value="#263B35" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.tqDateButton:pointerover">
      <Setter Property="BorderBrush" Value="#087F6E" />
      <Setter Property="Background" Value="#F8FCFB" />
    </Style>

    <Style Selector="RadioButton.tqChip">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#4B5D57" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="RadioButton.tqChip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F1F8F6" />
    </Style>

    <Style Selector="RadioButton.tqChip:checked">
      <Setter Property="Background" Value="#EAF9F5" />
      <Setter Property="BorderBrush" Value="#087F6E" />
      <Setter Property="Foreground" Value="#087F6E" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="RadioButton.tqChip:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#EAF9F5" />
    </Style>

    <Style Selector="TextBlock.tqMetricLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#61736E" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.tqMetricValue">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#163F38" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.tqSectionTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#163F38" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.tqSectionSub">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#61736E" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.tqMuted">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#7A8C86" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Nút dùng chung với toolbar của MainWindow, khai báo lại để UserControl độc lập -->
    <Style Selector="Button.toolbar-action">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344B45" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Button.toolbar-primary">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#163F38" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Style cho ComboBox bộ lọc Tổng quan -->
    <Style Selector="ComboBox.tqCombo">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Foreground" Value="#263B35" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox.tqCombo:pointerover">
      <Setter Property="BorderBrush" Value="#087F6E" />
    </Style>

    <Style Selector="ComboBox.tqCombo /template/ Path#DropDownGlyph">
      <Setter Property="Fill" Value="#4B5D57" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,12,16" Spacing="10">

      <!-- TIÊU ĐỀ + NÚT LÀM MỚI -->
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <StackPanel>
          <TextBlock Classes="page-title" Text="Tổng quan" TextWrapping="Wrap" />
          <TextBlock Text="Số liệu lấy trực tiếp từ dữ liệu bán hàng, nhập hàng và sổ quỹ"
            Foreground="#61736E" TextWrapping="Wrap" />
        </StackPanel>

        <ProgressBar Grid.Column="1" Width="120" Height="6" Margin="0,0,4,0"
          Classes="tqLoading" IsIndeterminate="True" VerticalAlignment="Center"
          IsVisible="{Binding DangTai}" />

        <Button Grid.Column="2" Classes="toolbar-action"
          Content="↻ Làm mới"
          IsEnabled="{Binding !DangTai}"
          Command="{Binding TaiLaiCommand}" />
      </Grid>

      <!-- BÁO LỖI -->
      <Border Classes="tqCard" Padding="14" Background="#FDECEC"
        BorderBrush="#F3C9C9" IsVisible="{Binding CoLoi}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Text="{Binding ThongBaoLoi}" Foreground="#B03A3A"
            TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="toolbar-action" Content="Thử lại"
            Command="{Binding TaiLaiCommand}" />
        </Grid>
      </Border>

      <!-- BỘ LỌC THỜI GIAN DÙNG CHUNG CHO TOÀN TRANG TỔNG QUAN -->
      <Border Classes="tqCard" Padding="12">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
          <StackPanel Spacing="5">
            <TextBlock Text="Khoảng thời gian (áp dụng cho toàn trang)" Classes="tqSectionSub" FontWeight="SemiBold" />
            <Border Background="#EEF4F2" CornerRadius="9" Padding="2">
              <WrapPanel Orientation="Horizontal" ItemSpacing="2" LineSpacing="2">
                <Button Classes="tqSegment" Classes.active="{Binding IsKhoangHomNay}"
                  Content="Hôm nay" Command="{Binding ChonKhoangThoiGianCommand}"
                  CommandParameter="HOM_NAY" />
                <Button Classes="tqSegment" Classes.active="{Binding IsKhoangBayNgay}"
                  Content="7 ngày" Command="{Binding ChonKhoangThoiGianCommand}"
                  CommandParameter="7_NGAY" />
                <Button Classes="tqSegment" Classes.active="{Binding IsKhoangThangNay}"
                  Content="Tháng này" Command="{Binding ChonKhoangThoiGianCommand}"
                  CommandParameter="THANG_NAY" />
                <Button Classes="tqSegment" Classes.active="{Binding IsKhoangThangTruoc}"
                  Content="Tháng trước" Command="{Binding ChonKhoangThoiGianCommand}"
                  CommandParameter="THANG_TRUOC" />
                <Button Classes="tqSegment" Classes.active="{Binding IsKhoangNamNay}"
                  Content="Năm nay" Command="{Binding ChonKhoangThoiGianCommand}"
                  CommandParameter="NAM_NAY" />
                <Button Classes="tqSegment" Classes.active="{Binding IsKhoangTuDien}"
                  Content="Tùy chọn" Command="{Binding ChonKhoangThoiGianCommand}"
                  CommandParameter="TU_DIEN" />
              </WrapPanel>
            </Border>
          </StackPanel>

          <!-- TÙY CHỌN KHOẢNG NGÀY -->
          <Border Grid.Row="1"
            Background="#F7FAF9"
            BorderBrush="#D8E5E0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,7"
            IsVisible="{Binding CoTheDungNgayTuChon}">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
              <StackPanel Spacing="3" Width="160">
                <TextBlock Text="Từ ngày" Classes="tqMetricLabel" />
                <DatePicker SelectedDate="{Binding TuNgayTuChon, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              </StackPanel>

              <StackPanel Spacing="3" Width="160">
                <TextBlock Text="Đến ngày" Classes="tqMetricLabel" />
                <DatePicker SelectedDate="{Binding DenNgayTuChon, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              </StackPanel>

              <Button Classes="toolbar-primary" Content="Áp dụng"
                Command="{Binding ApDungKhoangTuDienCommand}"
                Height="34" VerticalAlignment="Bottom" />
            </WrapPanel>
          </Border>
        </Grid>
      </Border>

      <!-- BANNER THÔNG TIN VÀ CHUYỂN NHANH KHI KỲ ĐANG CHỌN CHƯA CÓ DỮ LIỆU -->
      <Border Classes="tqCard" Background="#F0F8FF" BorderBrush="#BEE3F8"
        BorderThickness="1" CornerRadius="12" Padding="14,12"
        IsVisible="{Binding HienThiBannerChuaCoDuLieu}">
        <Grid x:Name="EmptyPeriodBannerGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="10">
          <Border Width="38" Height="38" CornerRadius="19" Background="#E1EFFE"
            VerticalAlignment="Center">
            <TextBlock Text="💡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="Chưa có dữ liệu phát sinh trong kỳ này"
              FontWeight="Bold" FontSize="13" Foreground="#1E429F" TextWrapping="Wrap" />
            <TextBlock Text="{Binding NoiDungBannerChuaCoDuLieu}"
              FontSize="12" Foreground="#3F83F8" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel x:Name="EmptyPeriodBannerActions" Grid.Column="2" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6"
            VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Classes="toolbar-action" Height="32" Padding="10,0" FontSize="11.5"
              IsVisible="{Binding CoTheXemThangTruoc}"
              Content="{Binding NhanNutThangTruocGoiY}"
              Command="{Binding ChuyenSangThangTruocCommand}" />
            <Button Classes="toolbar-action" Height="32" Padding="10,0" FontSize="11.5"
              Content="📅 Xem 7 ngày qua"
              Command="{Binding ChuyenSangBayNgayCommand}" />
            <Button Classes="toolbar-primary" Height="32" Padding="10,0" FontSize="11.5"
              IsVisible="{Binding CoTheXemNgayGanNhat}"
              Content="{Binding NhanNutNgayGanNhatGoiY}"
              Command="{Binding ChuyenSangNgayGanNhatCommand}" />
          </WrapPanel>
        </Grid>
      </Border>

      <!-- 5 THẺ KẾT QUẢ BÁN HÀNG THEO KỲ ĐANG CHỌN -->
      <Grid x:Name="MetricsGrid" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10" RowSpacing="10">
        <Border x:Name="MetricCard0" Classes="tqMetric" Padding="14">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
            <Border Width="34" Height="34" CornerRadius="10" Background="#EAF9F5" VerticalAlignment="Top">
              <TextBlock Text="₫" FontSize="18" FontWeight="Bold" Foreground="#087F6E"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding TieuDeTheDoanhThu}" Classes="tqMetricLabel"
              VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DoanhThuHomNayHienThi}"
              Classes="tqMetricValue" FontSize="19" Margin="0,6,0,2" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding PhuDeTheDoanhThu}"
              Classes="tqMuted" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border x:Name="MetricCard1" Grid.Column="1" Classes="tqMetric" Padding="14">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
            <Border Width="34" Height="34" CornerRadius="10" Background="#EEF2FF" VerticalAlignment="Top">
              <TextBlock Text="#" FontSize="18" FontWeight="Bold" Foreground="#5262A6"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="SỐ HÓA ĐƠN" Classes="tqMetricLabel"
              VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SoHoaDonHomNayHienThi}"
              Classes="tqMetricValue" FontSize="19" Margin="0,6,0,2" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding PhuDeTheSoHoaDon}"
              Classes="tqMuted" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border x:Name="MetricCard2" Grid.Column="2" Classes="tqMetric" Padding="14">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
            <Border Width="34" Height="34" CornerRadius="10" Background="#EAF9F5" VerticalAlignment="Top">
              <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="#087F6E"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="ĐÃ THU" Classes="tqMetricLabel"
              VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DaThuHomNayHienThi}"
              Classes="tqMetricValue" FontSize="19" Foreground="#087F6E" Margin="0,6,0,2" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding PhuDeTheDaThu}"
              Classes="tqMuted" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border x:Name="MetricCard3" Grid.Column="3" Classes="tqMetric" Padding="14">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
            <Border Width="34" Height="34" CornerRadius="10" Background="#FFF5E5" VerticalAlignment="Top">
              <TextBlock Text="!" FontSize="17" FontWeight="Bold" Foreground="#C27803"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="CÒN NỢ" Classes="tqMetricLabel"
              VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ConNoHomNayHienThi}"
              Classes="tqMetricValue" FontSize="19" Foreground="#C27803" Margin="0,6,0,2" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding PhuDeTheConNo}"
              Classes="tqMuted" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border x:Name="MetricCard4" Grid.Column="4" Classes="tqMetric" Padding="14">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
            <Border Width="34" Height="34" CornerRadius="10" Background="#F0F6F4" VerticalAlignment="Top">
              <TextBlock Text="↗" FontSize="18" FontWeight="Bold" Foreground="#163F38"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="SỐ ĐƠN HÀNG" Classes="tqMetricLabel"
              VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SoDonHangHomNayHienThi}"
              Classes="tqMetricValue" FontSize="19" Margin="0,6,0,2" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding PhuDeTheSoDonHang}"
              Classes="tqMuted" TextWrapping="Wrap" />
          </Grid>
        </Border>
      </Grid>

      <Border Classes="tqCard" Padding="12,10" IsVisible="{Binding CoHoaDonChuaGhiNhan}">
        <StackPanel Spacing="8">
          <Grid x:Name="ExcludedHeaderGrid" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="HÓA ĐƠN BỊ LOẠI TRỪ KHỎI TỔNG BÁN"
                Classes="tqSectionTitle" TextWrapping="Wrap" />
              <TextBlock Text="Gồm các hóa đơn ĐÃ HỦY hoặc LƯU TẠM trong kỳ. Không tính vào Doanh thu chính thức."
                Classes="tqSectionSub" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel x:Name="ExcludedHeaderActions" Grid.Column="1" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
              <Border Background="#FFF5E5" CornerRadius="6"
                Padding="8,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding SoHoaDonChuaGhiNhanHienThi, StringFormat='{}{0} hóa đơn'}"
                  FontSize="12" FontWeight="SemiBold" Foreground="#A45B00" />
              </Border>
              <Button Classes="tqViewSegment"
                      Command="{Binding XemChiTietHoaDonChuaGhiNhanCommand}"
                      Content="👁️ Xem danh sách"
                      Height="30"
                      Padding="10,0"
                      FontSize="12"
                      Cursor="Hand" />
            </WrapPanel>
          </Grid>
          <Grid x:Name="ExcludedMetricsGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" RowSpacing="8">
            <Border x:Name="ExcludedCard0" Classes="tqFilter" Padding="10,7">
              <StackPanel Spacing="2">
                <TextBlock Text="Tổng tiền hàng" Classes="tqMuted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding TongTienHangChuaGhiNhanHienThi}"
                  FontSize="16" FontWeight="Bold" Foreground="#163F38" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border x:Name="ExcludedCard1" Grid.Column="1" Classes="tqFilter" Padding="10,7">
              <StackPanel Spacing="2">
                <TextBlock Text="Doanh thu liên quan" Classes="tqMuted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DoanhThuChuaGhiNhanHienThi}"
                  FontSize="16" FontWeight="Bold" Foreground="#087F6E" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border x:Name="ExcludedCard2" Grid.Column="2" Classes="tqFilter" Padding="10,7">
              <StackPanel Spacing="2">
                <TextBlock Text="Đã thu từ hóa đơn" Classes="tqMuted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DaThuChuaGhiNhanHienThi}"
                  FontSize="16" FontWeight="Bold" Foreground="#087F6E" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border x:Name="ExcludedCard3" Grid.Column="3" Classes="tqFilter" Padding="10,7">
              <StackPanel Spacing="2">
                <TextBlock Text="Còn nợ trên hóa đơn" Classes="tqMuted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ConNoChuaGhiNhanHienThi}"
                  FontSize="16" FontWeight="Bold" Foreground="#A45B00" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- THỐNG KÊ KHO -->
      <Border Classes="tqCard" Padding="12">
        <Grid x:Name="WarehouseGrid" ColumnDefinitions="Auto,*,*,*,*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
          <StackPanel x:Name="WarehouseTitlePanel" VerticalAlignment="Center" Margin="0,0,6,0">
            <TextBlock Text="THỐNG KÊ KHO" Classes="tqSectionTitle" FontSize="13" TextWrapping="Wrap" />
            <TextBlock Text="Hiện tại" Classes="tqMuted" TextWrapping="Wrap" />
          </StackPanel>
          <Border x:Name="WarehouseCard0" Grid.Column="1" Classes="tqFilter" Padding="10,7">
            <StackPanel>
              <TextBlock Text="Tổng hàng hóa" Classes="tqMuted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TongSoHangHoa}" FontSize="18"
                FontWeight="Bold" Foreground="#163F38" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border x:Name="WarehouseCard1" Grid.Column="2" Classes="tqFilter" Padding="10,7">
            <StackPanel>
              <TextBlock Text="Sắp hết hàng" Classes="tqMuted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding HangSapHet}" FontSize="18"
                FontWeight="Bold" Foreground="#C27803" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border x:Name="WarehouseCard2" Grid.Column="3" Classes="tqFilter" Padding="10,7">
            <StackPanel>
              <TextBlock Text="Hết hàng" Classes="tqMuted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding HangHetHang}" FontSize="18"
                FontWeight="Bold" Foreground="#D64545" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border x:Name="WarehouseCard3" Grid.Column="4" Classes="tqFilter" Padding="10,7">
            <StackPanel>
              <TextBlock Text="Khách hàng" Classes="tqMuted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TongSoKhachHang}" FontSize="18"
                FontWeight="Bold" Foreground="#163F38" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border x:Name="WarehouseCard4" Grid.Column="5" Classes="tqFilter" Padding="10,7">
            <StackPanel>
              <TextBlock Text="Nhà cung cấp" Classes="tqMuted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TongSoNhaCungCap}" FontSize="18"
                FontWeight="Bold" Foreground="#163F38" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border x:Name="WarehouseInventoryValueCard" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
            Classes="tqFilter" Padding="10,7">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock Text="Giá trị tồn kho" Classes="tqMuted" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding GiaTriTonKhoHienThi}"
                FontSize="18" FontWeight="Bold" Foreground="#087F6E"
                TextWrapping="Wrap" TextAlignment="Right" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- BIỂU ĐỒ DOANH THU THEO KỲ & GÓC NHÌN -->
      <Border Classes="tqCard" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">

          <!-- Header -->
          <Grid x:Name="ChartHeaderGrid" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="8">
            <StackPanel Spacing="3">
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding TieuDeBieuDo}" Classes="tqSectionTitle" TextWrapping="Wrap" />
                <Border Background="#EAF9F5" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ChieuDoanhThuHienThi}" FontSize="11" FontWeight="SemiBold" Foreground="#087F6E" />
                </Border>
              </WrapPanel>
              <TextBlock Text="{Binding MoTaChieuDoanhThu}" Classes="tqSectionSub" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ThoiGianHienThi, StringFormat='Khoảng thời gian: {0}'}" Classes="tqMuted" TextWrapping="Wrap" />
              <!-- Góc nhìn chỉ điều khiển biểu đồ doanh thu nên đặt ngay trong khung biểu đồ -->
              <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,6,0,0">
                <TextBlock Text="Góc nhìn:" Classes="tqSectionSub" FontWeight="SemiBold"
                  VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button Classes="tqViewSegment" MinWidth="96" Height="32" Padding="10,0"
                  Classes.active="{Binding IsChieuTheoNgay}"
                  Command="{Binding ChonChieuDoanhThuCommand}" CommandParameter="NGAY">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="▦" FontSize="13" Foreground="#087F6E" />
                    <TextBlock Text="Theo ngày" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="tqViewSegment" MinWidth="96" Height="32" Padding="10,0"
                  Classes.active="{Binding IsChieuTheoGio}"
                  Command="{Binding ChonChieuDoanhThuCommand}" CommandParameter="GIO">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="◷" FontSize="13" Foreground="#087F6E" />
                    <TextBlock Text="Theo giờ" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="tqViewSegment" MinWidth="96" Height="32" Padding="10,0"
                  Classes.active="{Binding IsChieuTheoThu}"
                  Command="{Binding ChonChieuDoanhThuCommand}" CommandParameter="THU">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="▤" FontSize="13" Foreground="#087F6E" />
                    <TextBlock Text="Theo thứ" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
            <StackPanel x:Name="ChartHeaderSummaryPanel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock Text="{Binding TongDoanhThuKyChonHienThi}"
                         FontSize="20" FontWeight="Bold" Foreground="#087F6E"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding TongSoHoaDonKyChonHienThi}"
                         Classes="tqMuted" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <!-- 3 Thẻ phân tích theo Góc nhìn (Theo ngày / Theo giờ / Theo thứ) -->
          <Grid x:Name="ChartInsightsGrid" Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10" RowSpacing="8">
            <Border x:Name="InsightCard0" Background="#F2FBF8" BorderBrush="#CBECE3" BorderThickness="1" CornerRadius="10" Padding="12,8">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding TieuDeDiemCaoNhat}" FontSize="11" FontWeight="SemiBold" Foreground="#087F6E" TextWrapping="Wrap" />
                <TextBlock Text="{Binding GiaTriDiemCaoNhat}" FontSize="15" FontWeight="Bold" Foreground="#163F38" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PhuDeDiemCaoNhat}" Classes="tqMuted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border x:Name="InsightCard1" Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2ECE8" BorderThickness="1" CornerRadius="10" Padding="12,8">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding TieuDeTrungBinhChieu}" FontSize="11" FontWeight="SemiBold" Foreground="#4B5D57" TextWrapping="Wrap" />
                <TextBlock Text="{Binding GiaTriTrungBinhChieu}" FontSize="15" FontWeight="Bold" Foreground="#163F38" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PhuDeTrungBinhChieu}" Classes="tqMuted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border x:Name="InsightCard2" Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2ECE8" BorderThickness="1" CornerRadius="10" Padding="12,8">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding TieuDeMatDoChieu}" FontSize="11" FontWeight="SemiBold" Foreground="#4B5D57" TextWrapping="Wrap" />
                <TextBlock Text="{Binding GiaTriMatDoChieu}" FontSize="15" FontWeight="Bold" Foreground="#163F38" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PhuDeMatDoChieu}" Classes="tqMuted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Grid.Row="2" Height="1" Background="#EEF4F2" />

          <!-- Vùng biểu đồ -->
          <Grid Grid.Row="3">
            <ScrollViewer x:Name="ChartScrollViewer"
                          MinHeight="195"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="4,8,4,16"
                          IsVisible="{Binding CoDuLieu}">
              <Grid RowDefinitions="150,1,Auto"
                    MinWidth="{Binding #ChartScrollViewer.Bounds.Width}"
                    HorizontalAlignment="Left">
                <!-- Đường trục đáy trải dài toàn bộ chiều rộng vùng vẽ -->
                <Border Grid.Row="1" Height="1" Background="#D0DDD8" HorizontalAlignment="Stretch" />

                <!-- Các cột biểu đồ và nhãn trục hoành -->
                <ItemsControl Grid.RowSpan="3"
                              ItemsSource="{Binding BieuDoDoanhThu}"
                              VerticalAlignment="Stretch">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="0" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>

                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TongQuanDiemDoanhThu">
                      <Grid RowDefinitions="150,1,Auto"
                            Width="{Binding BeRongCot, FallbackValue=55}"
                            ToolTip.Tip="{Binding ToolTipDayDu}">

                        <!-- Cột + Số liệu trên đầu cột (Row 0: 150px, neo tại đáy) -->
                        <Grid Grid.Row="0">
                          <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Spacing="2">
                            <TextBlock Text="{Binding DoanhThuNganGon}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#087F6E"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       IsVisible="{Binding CoDoanhThu}" />
                            <TextBlock Text="{Binding SoHoaDonNganGon}"
                                       FontSize="9"
                                       Foreground="#61736E"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,0,0,1"
                                       IsVisible="{Binding CoDoanhThu}" />
                            <Border Height="{Binding ChieuCaoCot, FallbackValue=0}"
                                    CornerRadius="4,4,0,0"
                                    Background="{Binding MauCot}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch"
                                    Margin="4,0,4,0"
                                    Opacity="0.95"
                                    IsVisible="{Binding CoDoanhThu}" />
                          </StackPanel>
                        </Grid>

                        <!-- Trục hoành khớp từng cột -->
                        <Border Grid.Row="1" Height="1" Background="#D0DDD8" HorizontalAlignment="Stretch" />

                        <!-- Nhãn dưới cột (Row 2: Auto) -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding Nhan}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding MauChuNhan}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   Margin="2,6,2,2" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </ScrollViewer>
          </Grid>

          <Border Grid.Row="3" IsVisible="{Binding HienThiTrangThaiBieuDo}" Background="#F7FAF9"
              BorderBrush="#E2ECE8" BorderThickness="1" CornerRadius="10"
              Padding="14" HorizontalAlignment="Stretch">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding TrangThaiBieuDo}" FontWeight="SemiBold"
                  Foreground="#4B5D57" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" HorizontalAlignment="Center"
                  IsVisible="{Binding HienThiBannerChuaCoDuLieu}">
                  <Button Classes="toolbar-action" Height="30" Padding="10,0" FontSize="11"
                    IsVisible="{Binding CoTheXemThangTruoc}"
                    Content="{Binding NhanNutThangTruocGoiY}"
                    Command="{Binding ChuyenSangThangTruocCommand}" />
                  <Button Classes="toolbar-action" Height="30" Padding="10,0" FontSize="11"
                    Content="📅 Xem 7 ngày qua"
                    Command="{Binding ChuyenSangBayNgayCommand}" />
                </WrapPanel>
              </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- TOP 10 -->
      <StackPanel Spacing="8">
        <Grid x:Name="Top10SectionHeaderGrid" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="4">
          <StackPanel Spacing="2">
            <TextBlock Text="Thống kê Top 10" Classes="tqSectionTitle" TextWrapping="Wrap" />
            <TextBlock Text="Bộ lọc xếp hạng chỉ áp dụng cho Top 10 hàng bán chạy; Top 10 khách hàng luôn xếp theo doanh thu."
              Classes="tqSectionSub" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock x:Name="Top10SectionPeriodText" Grid.Column="1" Text="{Binding ThoiGianHienThi}" Classes="tqMuted"
            VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>

        <Grid x:Name="Top10Grid" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
          <!-- TOP 10 HÀNG -->
          <Border x:Name="TopProductsCard" Classes="tqCard" Padding="16">
            <StackPanel Spacing="8">
              <Grid x:Name="TopProductsHeaderGrid" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="6">
                <StackPanel>
                  <TextBlock Text="TOP 10 HÀNG BÁN CHẠY" Classes="tqSectionTitle"
                    TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ThoiGianHienThi}" Classes="tqSectionSub"
                    Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Tùy chọn chỉ điều khiển Top 10 hàng nên đặt ngay trong tiêu đề khung -->
                <WrapPanel x:Name="TopProductsFilterPanel" Grid.Column="1" Orientation="Horizontal" ItemSpacing="6"
                  LineSpacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="Xếp hạng:" Classes="tqMuted" VerticalAlignment="Center" />
                  <RadioButton GroupName="tqXepTop10" Classes="tqChip"
                    Content="Doanh thu"
                    IsChecked="{Binding XepHangTopHang, Mode=TwoWay, Converter={StaticResource TongQuanChonRadio}, ConverterParameter=DOANH_THU}"
                    Command="{Binding ChonXepHangTopCommand}"
                    CommandParameter="DOANH_THU" />
                  <RadioButton GroupName="tqXepTop10" Classes="tqChip"
                    Content="Số lượng"
                    IsChecked="{Binding XepHangTopHang, Mode=TwoWay, Converter={StaticResource TongQuanChonRadio}, ConverterParameter=SO_LUONG}"
                    Command="{Binding ChonXepHangTopCommand}"
                    CommandParameter="SO_LUONG" />
                </WrapPanel>
              </Grid>

              <Border Height="1" Background="#EEF4F2" />

              <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding TopHangBanChay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TongQuanHangTop">
                      <Border Classes="tqRow">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8">
                            <Border Width="22" Height="22" CornerRadius="11"
                              Background="#EAF9F5" VerticalAlignment="Top" Margin="0,2,0,0">
                              <TextBlock Text="{Binding ThuTu}" FontSize="11"
                                Foreground="#087F6E" FontWeight="SemiBold"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Ten}"
                                FontWeight="SemiBold" Foreground="#263B35"
                                TextWrapping="Wrap" LineHeight="18" />
                              <TextBlock Text="{Binding TenPhu}" Classes="tqMuted"
                                TextWrapping="Wrap"
                                IsVisible="{Binding TenPhu, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                              Spacing="12" VerticalAlignment="Top" Margin="0,2,0,0">
                              <TextBlock Text="{Binding SoLuongHienThi}" Classes="tqMuted"
                                VerticalAlignment="Center" />
                              <TextBlock Text="{Binding DoanhThuHienThi}" FontWeight="SemiBold"
                                Foreground="#087F6E" MinWidth="90"
                                TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="28,*">
                            <ProgressBar Grid.Column="1" Classes="tqBar"
                              Minimum="0" Maximum="100"
                              Value="{Binding TyLeBeRong}"
                              ClipToBounds="True" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock Text="Chưa có dữ liệu bán hàng trong khoảng thời gian này"
                Classes="tqMuted" HorizontalAlignment="Center" Margin="0,10,0,0"
                IsVisible="{Binding !CoHangBanChay}" />
            </StackPanel>
          </Border>

          <!-- TOP 10 KHÁCH HÀNG -->
          <Border x:Name="TopCustomersCard" Grid.Column="1" Classes="tqCard" Padding="16">
            <StackPanel Spacing="8">
              <Grid x:Name="TopCustomersHeaderGrid" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="4">
                <StackPanel>
                  <TextBlock Text="TOP 10 KHÁCH HÀNG" Classes="tqSectionTitle"
                    TextWrapping="Wrap" />
                  <TextBlock Text="Khách hàng mua nhiều nhất theo doanh thu" Classes="tqSectionSub"
                    Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="TopCustomersPeriodText" Grid.Column="1" Text="{Binding ThoiGianHienThi}" Classes="tqMuted"
                  VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>

              <Border Height="1" Background="#EEF4F2" />

              <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding TopKhachHang}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TongQuanHangTop">
                      <Border Classes="tqRow">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8">
                            <Border Width="22" Height="22" CornerRadius="11"
                              Background="#EAF9F5" VerticalAlignment="Top" Margin="0,2,0,0">
                              <TextBlock Text="{Binding ThuTu}" FontSize="11"
                                Foreground="#087F6E" FontWeight="SemiBold"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Ten}"
                                FontWeight="SemiBold" Foreground="#263B35"
                                TextWrapping="Wrap" LineHeight="18" />
                              <TextBlock Text="{Binding TenPhu}" Classes="tqMuted"
                                TextWrapping="Wrap"
                                IsVisible="{Binding TenPhu, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding DoanhThuHienThi}"
                              FontWeight="SemiBold" Foreground="#087F6E"
                              VerticalAlignment="Top" Margin="0,2,0,0" MinWidth="90"
                              TextAlignment="Right" />
                          </Grid>

                          <Grid ColumnDefinitions="28,*">
                            <ProgressBar Grid.Column="1" Classes="tqBar"
                              Minimum="0" Maximum="100"
                              Value="{Binding TyLeBeRong}"
                              ClipToBounds="True" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock Text="Chưa có dữ liệu khách hàng trong khoảng thời gian này"
                Classes="tqMuted" HorizontalAlignment="Center" Margin="0,10,0,0"
                IsVisible="{Binding !CoKhachHang}" />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <!-- ========================================================= -->
      <!-- NHẬT KÝ HOẠT ĐỘNG NHÂN VIÊN (CHỈ DÀNH CHO ADMIN)          -->
      <!-- ========================================================= -->
      <Border Classes="tqCard" Padding="18" Margin="0,4,0,0" IsVisible="{Binding IsAdmin}">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
          <!-- HÀNG 1: TIÊU ĐỀ VÀ THÔNG TIN QUYỀN -->
          <Grid x:Name="ActivityHeaderGrid" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="8">
            <StackPanel Spacing="4">
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" VerticalAlignment="Center">
                <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG NHÂN VIÊN" Classes="tqSectionTitle" TextWrapping="Wrap" />
                <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                  <TextBlock Text="DÀNH CHO QUẢN TRỊ VIÊN" FontSize="10" FontWeight="Bold" Foreground="#B45309" />
                </Border>
              </WrapPanel>
              <TextBlock Text="Theo dõi chi tiết các thao tác bán hàng, xuất nhập kho, thu chi và cập nhật từ đội ngũ nhân sự"
                         Classes="tqSectionSub" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Tổng số hoạt động gần nhất -->
            <Border x:Name="ActivityHeaderCountBadge" Grid.Column="1" Classes="tqFilter" Padding="10,6" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Text="{Binding SoLuongHoatDongTaiKhoanCon, StringFormat='{}{0} hoạt động gần nhất'}"
                         FontSize="12" FontWeight="SemiBold" Foreground="#163F38" />
            </Border>
          </Grid>

          <!-- HÀNG 2: BỘ LỌC TÌM KIẾM, NHÂN VIÊN, HÀNH ĐỘNG, ĐẶT LẠI -->
          <Grid x:Name="ActivityFilterGrid" Grid.Row="1" ColumnDefinitions="2*,1.2*,1.2*,Auto" ColumnSpacing="10" RowSpacing="8">
            <!-- Ô tìm kiếm -->
            <TextBox x:Name="ActivitySearchBox"
                     Text="{Binding TimKiemHoatDongSub}"
                     Watermark="🔍 Tìm nhân viên, mã đơn, chứng từ, ghi chú..."
                     CornerRadius="8" Padding="10,7" FontSize="12" MinHeight="36"
                     VerticalContentAlignment="Center"
                     BorderBrush="#D8E5E0" BorderThickness="1" Background="#FFFFFF" />

            <!-- Lọc theo nhân viên -->
            <ComboBox x:Name="ActivityUserCombo"
                      Grid.Column="1"
                      Classes="tqCombo"
                      ItemsSource="{Binding DanhSachTaiKhoanCon}"
                      SelectedItem="{Binding LocTaiKhoanSub}"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="Lọc theo nhân viên">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="#263B35" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Lọc theo loại hành động -->
            <ComboBox x:Name="ActivityActionCombo"
                      Grid.Column="2"
                      Classes="tqCombo"
                      ItemsSource="{Binding DanhSachHanhDongCon}"
                      SelectedItem="{Binding LocHanhDongSub}"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="Lọc theo nghiệp vụ">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="#263B35" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Nút đặt lại bộ lọc -->
            <Button x:Name="ActivityResetButton"
                    Grid.Column="3"
                    Command="{Binding XoaBoLocHoatDongSubCommand}"
                    Classes="toolbar-action"
                    Height="36"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Đặt lại bộ lọc về mặc định">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="↺" FontSize="13" VerticalAlignment="Center" Foreground="#4B5D57" />
                <TextBlock Text="Đặt lại" FontSize="12" VerticalAlignment="Center" Foreground="#4B5D57" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Đường kẻ phân cách -->
          <Border Grid.Row="2" Height="1" Background="#EEF4F2" />

          <!-- HÀNG 3: DANH SÁCH HOẠT ĐỘNG -->
          <Grid Grid.Row="3">
            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
              <ItemsControl ItemsSource="{Binding HoatDongTaiKhoanCon}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:TongQuanHoatDongTaiKhoanCon">
                    <Border Background="#FBFDFC"
                            BorderBrush="#E3EEE9"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,11"
                            Margin="0,0,0,8">
                      <StackPanel Spacing="7">
                        <!-- Dòng 1: Nhân viên | Loại hoạt động (+ Giá trị tiền) -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#EAF9F5" VerticalAlignment="Top">
                              <TextBlock Text="👤" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding NguoiThucHienHienThi}"
                                       FontWeight="Bold"
                                       Foreground="#163F38"
                                       FontSize="13.5"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                          </Grid>

                          <WrapPanel Grid.Column="1"
                                     Orientation="Horizontal"
                                     ItemSpacing="6"
                                     LineSpacing="4"
                                     MaxWidth="340"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top">
                            <Border Background="{Binding MauNenBadgeHanhDong}"
                                    BorderBrush="{Binding MauVienBadgeHanhDong}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding HanhDong}"
                                         FontWeight="Bold"
                                         FontSize="11.5"
                                         Foreground="{Binding MauBadgeHanhDong}"
                                         TextWrapping="Wrap" />
                            </Border>

                            <Border Background="#ECFDF5"
                                    BorderBrush="#A7F3D0"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding CoGiaTri}">
                              <TextBlock Text="{Binding GiaTriHienThi}"
                                         FontWeight="Bold"
                                         FontSize="12"
                                         Foreground="#047857" />
                            </Border>
                          </WrapPanel>
                        </Grid>

                        <!-- Dòng 2: Vai trò nhân viên | Thời gian -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="34,0,0,0">
                          <Border Grid.Column="0"
                                  Background="{Binding MauNenBadgeVaiTro}"
                                  CornerRadius="5"
                                  Padding="7,2"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding VaiTroHienThi}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding MauBadgeVaiTro}"
                                       TextWrapping="Wrap" />
                          </Border>

                          <TextBlock Grid.Column="1"
                                     Text="{Binding ThoiGianHienThi}"
                                     Classes="tqMuted"
                                     FontSize="11.5"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Dòng 3: Mã phiếu & Nội dung mô tả hoạt động -->
                        <Border Margin="34,0,0,0"
                                Background="#F3F7F5"
                                BorderBrush="#E4EFEA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                IsVisible="{Binding CoChiTietMoTa}">
                          <StackPanel Spacing="6">
                            <Border Background="#FFFFFF"
                                    BorderBrush="#CFE0DA"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding CoMaChungTu}">
                              <TextBlock Text="{Binding MaChungTuHienThi}"
                                         FontSize="11.5"
                                         FontWeight="SemiBold"
                                         Foreground="#163F38"
                                         TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding NoiDung}"
                                       Foreground="#263B35"
                                       FontSize="12.5"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding CoNoiDung}" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Trạng thái trống khi chưa có hoạt động nào -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30" Spacing="8"
                        IsVisible="{Binding !CoHoatDongTaiKhoanCon}">
              <TextBlock Text="📋" FontSize="26" HorizontalAlignment="Center" />
              <TextBlock Text="Chưa có hoạt động nào được ghi nhận từ nhân viên."
                         Classes="tqMuted" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
