<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:ShopHoa.Models"
  x:Class="ShopHoa.Views.PhieuNhapDetailWindow"
  x:DataType="models:PhieuNhapHangDetail"
  Title="{Binding TieuDe}"
  Width="1080"
  Height="840"
  MinWidth="900"
  MinHeight="640"
  WindowStartupLocation="CenterOwner"
  Background="#F4FAF8">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#263B35" />
    </Style>

    <Style Selector="Button.toolbar-primary">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#087F6E" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.toolbar-primary:pointerover">
      <Setter Property="Background" Value="#056B5D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#163F38" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#61736E" />
    </Style>

    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#263B35" />
    </Style>

    <Style Selector="TextBlock.table-header">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#164B40" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid Margin="22"
    RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
    RowSpacing="14">

    <!-- 1. TIÊU ĐỀ + BADGE TRẠNG THÁI -->
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="CHI TIẾT PHIẾU NHẬP HÀNG"
          FontSize="22"
          FontWeight="Bold"
          Foreground="#163F38" />
        <TextBlock Text="{Binding MaPhieuNhap}"
          FontSize="15"
          FontWeight="SemiBold"
          Foreground="#087F6E" />
      </StackPanel>

      <StackPanel Grid.Column="1"
        VerticalAlignment="Center">
        <Border IsVisible="{Binding IsDaHuy}"
          Background="#FEF3F2"
          CornerRadius="14"
          Padding="14,6"
          HorizontalAlignment="Right">
          <TextBlock Text="ĐÃ HỦY"
            FontSize="12"
            FontWeight="Bold"
            Foreground="#B42318" />
        </Border>

        <Border IsVisible="{Binding !IsDaHuy}"
          Background="#E8F6F1"
          CornerRadius="14"
          Padding="14,6"
          HorizontalAlignment="Right">
          <TextBlock Text="{Binding TrangThaiHienThi}"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="#087F6E" />
        </Border>

        <Border IsVisible="{Binding !IsDaHuy}"
          Background="{Binding TrangThaiThanhToanBadgeBrush}"
          CornerRadius="14"
          Padding="14,6"
          Margin="0,6,0,0"
          HorizontalAlignment="Right">
          <TextBlock Text="{Binding TrangThaiThanhToanHienThi}"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="{Binding TrangThaiThanhToanBadgeForeground}" />
        </Border>

        <!-- BADGE ĐÃ CHỈNH SỬA PHIẾU -->
        <Border IsVisible="{Binding CoLichSuThayDoi}"
          Background="#FFF7E8"
          BorderBrush="#FED7AA"
          BorderThickness="1"
          CornerRadius="14"
          Padding="12,5"
          Margin="0,6,0,0"
          HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock Text="✏" FontSize="11" Foreground="#B45309" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SoLanChinhSuaText}"
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="#B45309"
              VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- BANNER PHIẾU ĐÃ HỦY (Chỉ hiển thị khi phiếu có trạng thái ĐÃ HỦY) -->
    <Border Grid.Row="1"
      IsVisible="{Binding IsDaHuy}"
      Background="#FEF2F2"
      BorderBrush="#FECACA"
      BorderThickness="1"
      CornerRadius="10"
      Padding="14,10">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="6" ColumnSpacing="12">
        <Border Width="34" Height="34" CornerRadius="17" Background="#FEE2E2" VerticalAlignment="Center">
          <TextBlock Text="🚫" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="PHIẾU NHẬP NÀY ĐÃ BỊ HỦY" FontWeight="Bold" FontSize="13" Foreground="#991B1B" />
          <TextBlock Text="{Binding ThongTinHuyText}" FontSize="12" Foreground="#B91C1C" />
        </StackPanel>
        <Border Grid.Column="2" Background="#FEE2E2" CornerRadius="6" Padding="10,5" VerticalAlignment="Center" IsVisible="{Binding CoSoTienHoan}">
          <TextBlock Text="{Binding SoTienHoanText, StringFormat='Đã hoàn quỹ: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#991B1B" />
        </Border>
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding CoLyDoHuy}">
          <TextBlock Text="Lý do hủy:" FontSize="12" FontWeight="SemiBold" Foreground="#991B1B" />
          <TextBlock Text="{Binding LyDoHuy}" FontSize="12" Foreground="#7F1D1D" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 2. THÔNG TIN PHIẾU -->
    <Border Grid.Row="2"
      Background="White"
      BorderBrush="#E2ECE8"
      BorderThickness="1"
      CornerRadius="12"
      Padding="16"
      BoxShadow="0 2 8 #080A352E">

      <Grid ColumnDefinitions="*,*"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
        ColumnSpacing="24"
        RowSpacing="10">

        <!-- HÀNG 1: THỜI GIAN & NGƯỜI TẠO -->
        <StackPanel Spacing="2">
          <TextBlock Classes="label" Text="Ngày giờ nhận hàng thực tế" />
          <TextBlock Classes="value" Text="{Binding ThoiGianNhapText}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Classes="label" Text="Người tạo phiếu" />
          <TextBlock Classes="value" Text="{Binding TenNhanVienHienThi}" />
        </StackPanel>

        <!-- HÀNG 2: THÔNG TIN NHÀ CUNG CẤP CHI TIẾT -->
        <StackPanel Grid.Row="1" Spacing="2">
          <TextBlock Classes="label" Text="Mã nhà cung cấp" />
          <TextBlock Classes="value" FontWeight="SemiBold" Text="{Binding MaNhaCungCapHienThi}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
          <TextBlock Classes="label" Text="Tên nhà cung cấp" />
          <TextBlock Classes="value" FontWeight="Bold" Foreground="#164B40" Text="{Binding TenNhaCungCapHienThi}" />
        </StackPanel>

        <!-- HÀNG 3: ĐỊA CHỈ & SĐT / MST NCC -->
        <StackPanel Grid.Row="2" Spacing="2">
          <TextBlock Classes="label" Text="Điện thoại &amp; MST NCC" />
          <TextBlock Classes="value">
            <Run Text="{Binding SoDienThoaiNhaCungCap, FallbackValue='—'}" />
            <Run Text=" | MST: " />
            <Run Text="{Binding MaSoThueNhaCungCap, FallbackValue='—'}" />
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
          <TextBlock Classes="label" Text="Địa chỉ nhà cung cấp" />
          <TextBlock Classes="value" Text="{Binding DiaChiNhaCungCap, FallbackValue='—'}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- HÀNG 4: THÔNG TIN GIAO NHẬN (SHIPPER) -->
        <StackPanel Grid.Row="3" Spacing="2" IsVisible="{Binding CoNguoiGiaoHang}">
          <TextBlock Classes="label" Text="Người giao hàng (Đại diện NCC)" />
          <TextBlock Classes="value" FontWeight="SemiBold" Text="{Binding TenNguoiGiaoHang, FallbackValue='—'}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2" IsVisible="{Binding CoNguoiGiaoHang}">
          <TextBlock Classes="label" Text="SĐT người giao hàng" />
          <TextBlock Classes="value" Text="{Binding SdtNguoiGiaoHang, FallbackValue='—'}" />
        </StackPanel>

        <!-- HÀNG 5: HÓA ĐƠN ĐẦU VÀO & NGÀY HÓA ĐƠN -->
        <StackPanel Grid.Row="4" Spacing="2" IsVisible="{Binding CoSoHoaDon}">
          <TextBlock Classes="label" Text="Số hóa đơn đầu vào" />
          <TextBlock Classes="value" FontWeight="SemiBold" Text="{Binding SoHoaDonDauVao}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2" IsVisible="{Binding CoNgayHoaDon}">
          <TextBlock Classes="label" Text="Ngày hóa đơn đầu vào" />
          <TextBlock Classes="value" Text="{Binding NgayHoaDonDauVaoHienThi}" />
        </StackPanel>

        <!-- HÀNG 6: PHƯƠNG THỨC & NGUỒN QUỸ -->
        <StackPanel Grid.Row="5" Spacing="2">
          <TextBlock Classes="label" Text="Phương thức thanh toán" />
          <TextBlock Classes="value" FontWeight="SemiBold" Text="{Binding PhuongThucThanhToanHienThi}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.Column="1" Spacing="2">
          <TextBlock Classes="label" Text="Nguồn quỹ chi trả" />
          <TextBlock Classes="value" FontWeight="SemiBold" Foreground="#087F6E" Text="{Binding NguonQuyChiTraHienThi}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 3. DANH SÁCH HÀNG HÓA -->
    <Border Grid.Row="3"
      Background="White"
      BorderBrush="#E2ECE8"
      BorderThickness="1"
      CornerRadius="12"
      ClipToBounds="True">

      <Grid RowDefinitions="Auto,*,Auto">

        <Border Background="#EBF5F1"
          BorderBrush="#D5EAE3"
          BorderThickness="0,0,0,1"
          Padding="16,11">
          <Grid ColumnDefinitions="45,115,*,75,65,115,95,125"
            MinWidth="860"
            ColumnSpacing="8">
            <TextBlock Classes="table-header" Text="STT" />
            <TextBlock Grid.Column="1" Classes="table-header" Text="MÃ HÀNG" />
            <TextBlock Grid.Column="2" Classes="table-header" Text="TÊN HÀNG" />
            <TextBlock Grid.Column="3" Classes="table-header" Text="ĐVT" />
            <TextBlock Grid.Column="4" Classes="table-header" Text="SL"
              HorizontalAlignment="Right" />
            <TextBlock Grid.Column="5" Classes="table-header" Text="ĐƠN GIÁ"
              HorizontalAlignment="Right" />
            <TextBlock Grid.Column="6" Classes="table-header" Text="GIẢM GIÁ"
              HorizontalAlignment="Right" />
            <TextBlock Grid.Column="7" Classes="table-header" Text="THÀNH TIỀN"
              HorizontalAlignment="Right" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Auto"
          IsVisible="{Binding CoHangHoa}">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PhieuNhapHangDetailItem">
                <Border BorderBrush="#EEF3F1"
                  BorderThickness="0,0,0,1"
                  Padding="16,9">
                  <Grid ColumnDefinitions="45,115,*,75,65,115,95,125"
                    MinWidth="860"
                    ColumnSpacing="8"
                    VerticalAlignment="Center">
                    <TextBlock Text="{Binding Index}"
                      FontSize="12"
                      Foreground="#667A74"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding MaSanPham}"
                      FontSize="12"
                      Foreground="#163F38"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding TenSanPham}"
                      FontSize="13"
                      TextWrapping="Wrap"
                      ToolTip.Tip="{Binding TenSanPham}"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding DonViTinhHienThi}"
                      FontSize="12"
                      Foreground="#61736E"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding SoLuongText}"
                      FontSize="12"
                      Foreground="#263B35"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding DonGiaNhapText}"
                      FontSize="12"
                      Foreground="#263B35"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding GiamGiaText}"
                      FontSize="12"
                      Foreground="#D64545"
                      IsVisible="{Binding CoGiamGia}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="0"
                      FontSize="12"
                      Foreground="#98A2B3"
                      IsVisible="{Binding !CoGiamGia}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="{Binding ThanhTienText}"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="#163F38"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
          IsVisible="{Binding !CoHangHoa}"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          Spacing="6">
          <TextBlock Text="🗂"
            FontSize="34"
            HorizontalAlignment="Center"
            Foreground="#B7C9C3" />
          <TextBlock Text="Phiếu nhập chưa có hàng hóa"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="#61736E"
            HorizontalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="2"
          Background="#F7FAF9"
          BorderBrush="#E2ECE8"
          BorderThickness="0,1,0,0"
          Padding="16,12">
          <StackPanel Spacing="8"
            HorizontalAlignment="Right"
            Width="360">

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="Tổng tiền hàng" />
              <TextBlock Grid.Column="1"
                Text="{Binding TongTienHangText}"
                FontSize="13"
                Foreground="#263B35"
                HorizontalAlignment="Right" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto"
              IsVisible="{Binding HasGiamGia}">
              <TextBlock Classes="label" Text="Giảm giá" />
              <TextBlock Grid.Column="1"
                Text="{Binding GiamGiaText}"
                FontSize="13"
                Foreground="#D64545"
                HorizontalAlignment="Right" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto"
              IsVisible="{Binding HasChiPhiKhac}">
              <TextBlock Classes="label" Text="Chi phí khác" />
              <TextBlock Grid.Column="1"
                Text="{Binding ChiPhiKhacText}"
                FontSize="13"
                Foreground="#263B35"
                HorizontalAlignment="Right" />
            </Grid>

            <Border BorderBrush="#D5EAE3"
              BorderThickness="0,1,0,0"
              Padding="0,8,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="TỔNG THANH TOÁN"
                  FontSize="15"
                  FontWeight="Bold"
                  Foreground="#163F38" />
                <TextBlock Grid.Column="1"
                  Text="{Binding TongTienNhapText}"
                  FontSize="15"
                  FontWeight="Bold"
                  Foreground="#087F6E"
                  HorizontalAlignment="Right" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="Đã thanh toán" />
              <TextBlock Grid.Column="1"
                Text="{Binding DaThanhToanText}"
                FontSize="13"
                Foreground="#263B35"
                HorizontalAlignment="Right" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto"
              IsVisible="{Binding CoThanhToan}">
              <TextBlock Classes="label" Text="Nguồn tiền chi trả" />
              <TextBlock Grid.Column="1"
                Text="{Binding PhuongThucThanhToanHienThi}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#087F6E"
                HorizontalAlignment="Right" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Còn nợ"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#61736E" />
              <TextBlock Grid.Column="1"
                Text="{Binding ConNoText}"
                FontSize="13"
                FontWeight="Bold"
                Foreground="#D64545"
                HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 4. LỊCH SỬ THANH TOÁN CÔNG NỢ CỦA PHIẾU -->
    <Border Grid.Row="4"
      Background="White"
      BorderBrush="#E2ECE8"
      BorderThickness="1"
      CornerRadius="12"
      ClipToBounds="True"
      IsVisible="{Binding CoLichSuThanhToan}">

      <Grid RowDefinitions="Auto,Auto,Auto">

        <Border Background="#EBF5F1"
          BorderBrush="#D5EAE3"
          BorderThickness="0,0,0,1"
          Padding="16,10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section-title" Text="Lịch sử thanh toán công nợ" />
            <TextBlock Grid.Column="1"
              Text="{Binding TongDaThanhToanLichSuText, StringFormat='Tổng đã ghi nhận: {0}'}"
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="#087F6E"
              VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Grid.Row="1"
          Background="#F7FAF9"
          BorderBrush="#E2ECE8"
          BorderThickness="0,0,0,1"
          Padding="16,8">
          <Grid ColumnDefinitions="145,145,125,*,135"
            ColumnSpacing="10">
            <TextBlock Classes="table-header" Text="THỜI GIAN" />
            <TextBlock Grid.Column="1" Classes="table-header" Text="MÃ THANH TOÁN" />
            <TextBlock Grid.Column="2" Classes="table-header" Text="PHƯƠNG THỨC" />
            <TextBlock Grid.Column="3" Classes="table-header" Text="NGƯỜI THỰC HIỆN" />
            <TextBlock Grid.Column="4" Classes="table-header" Text="SỐ TIỀN"
              HorizontalAlignment="Right" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
          MaxHeight="130"
          VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Payments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PhieuNhapHangPaymentItem">
                <Border BorderBrush="#EEF3F1"
                  BorderThickness="0,0,0,1"
                  Padding="16,8"
                  ToolTip.Tip="{Binding GhiChuHienThi}">
                  <Grid ColumnDefinitions="145,145,125,*,135"
                    ColumnSpacing="10"
                    VerticalAlignment="Center">
                    <TextBlock Text="{Binding ThoiGianText}"
                      FontSize="12"
                      Foreground="#667A74"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                      Text="{Binding MaThanhToanHienThi}"
                      FontSize="12"
                      FontWeight="SemiBold"
                      Foreground="#163F38"
                      TextTrimming="CharacterEllipsis"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                      Text="{Binding PhuongThucHienThi}"
                      FontSize="12"
                      Foreground="#344B45"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                      Text="{Binding NguoiThucHienHienThi}"
                      FontSize="12"
                      Foreground="#344B45"
                      TextTrimming="CharacterEllipsis"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                      Text="{Binding SoTienText}"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="#087F6E"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- 5. LỊCH SỬ THAY ĐỔI PHIẾU NHẬP (Chỉ hiển thị nếu phiếu đó đã có người thay đổi) -->
    <Border Grid.Row="5"
      Background="White"
      BorderBrush="#FED7AA"
      BorderThickness="1"
      CornerRadius="12"
      ClipToBounds="True"
      IsVisible="{Binding CoLichSuThayDoi}">

      <Grid RowDefinitions="Auto,Auto,Auto">

        <Border Background="#FFF7ED"
          BorderBrush="#FED7AA"
          BorderThickness="0,0,0,1"
          Padding="16,10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="📝" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Classes="section-title" Foreground="#9A3412" Text="Lịch sử thay đổi phiếu nhập" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1"
              Text="{Binding SoLanChinhSuaText}"
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="#B45309"
              VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Grid.Row="1"
          Background="#FFFDF9"
          BorderBrush="#FEE2E2"
          BorderThickness="0,0,0,1"
          Padding="16,8">
          <Grid ColumnDefinitions="140,150,*,140,140"
            ColumnSpacing="10">
            <TextBlock Classes="table-header" Text="THỜI GIAN" />
            <TextBlock Grid.Column="1" Classes="table-header" Text="NGƯỜI THỰC HIỆN" />
            <TextBlock Grid.Column="2" Classes="table-header" Text="LÝ DO / CHI TIẾT THAY ĐỔI" />
            <TextBlock Grid.Column="3" Classes="table-header" Text="TIỀN TRƯỚC" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Classes="table-header" Text="TIỀN SAU" HorizontalAlignment="Right" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
          MaxHeight="140"
          VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding EditHistory}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:LichSuChinhSuaPhieuNhap">
                <Border BorderBrush="#FEE2E2"
                  BorderThickness="0,0,0,1"
                  Padding="16,10"
                  ToolTip.Tip="{Binding ChiTietThayDoi}">
                  <Grid ColumnDefinitions="140,150,*,140,140"
                    ColumnSpacing="10"
                    VerticalAlignment="Top">
                    <TextBlock Text="{Binding ThoiGianText}"
                      FontSize="12"
                      Foreground="#667A74"
                      VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1"
                      Text="{Binding TenNguoiThucHien}"
                      FontSize="12"
                      FontWeight="SemiBold"
                      Foreground="#163F38"
                      TextTrimming="CharacterEllipsis"
                      VerticalAlignment="Top" />
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Top">
                      <TextBlock Text="{Binding LyDo}"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="#B45309"
                        TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ChiTietThayDoi}"
                        FontSize="11.5"
                        Foreground="#61736E"
                        TextWrapping="Wrap"
                        IsVisible="{Binding HasChiTietThayDoi}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                      Text="{Binding TongTienTruocText}"
                      FontSize="12"
                      Foreground="#7A8C87"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top" />
                    <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="2">
                      <TextBlock Text="{Binding TongTienSauText}"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="#087F6E"
                        HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding ChenhLechTienText}"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="#B45309"
                        HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

        <!-- 6. CHỨNG TỪ ĐÍNH KÈM (ISSUE #61) -->
    <Border Grid.Row="6"
      Background="White"
      BorderBrush="#D5EAE3"
      BorderThickness="1"
      CornerRadius="12"
      ClipToBounds="True"
      IsVisible="{Binding CoDinhKem}">

      <Grid RowDefinitions="Auto,Auto">
        <Border Background="#EBF5F1"
          BorderBrush="#D5EAE3"
          BorderThickness="0,0,0,1"
          Padding="16,10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="📎" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Classes="section-title" Text="Chứng từ đính kèm (Hóa đơn giấy, biên bản, ảnh kho)" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1"
              Text="{Binding DinhKems.Count, StringFormat='Tổng số: {0} tài liệu'}"
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="#087F6E"
              VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding DinhKems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:DinhKemPhieuNhap">
                <Border BorderBrush="#EEF3F1" BorderThickness="0,0,0,1" Padding="16,8">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <TextBlock Text="📄" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding TenFileGoc}" FontSize="12.5" FontWeight="SemiBold" Foreground="#163F38" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TenFileGoc}" />
                      <TextBlock Text="{Binding DungLuongHienThi, StringFormat='Dung lượng: {0}'}" FontSize="11" Foreground="#667A74" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding TenNguoiTaiLen, StringFormat='Người tải: {0}'}" FontSize="11.5" Foreground="#344B45" />
                      <TextBlock Text="{Binding ThoiGianTaiLenHienThi}" FontSize="11" Foreground="#667A74" />
                    </StackPanel>
                    <Button Grid.Column="3"
                      Classes="toolbar-primary"
                      Background="#087F6E"
                      BorderBrush="#087F6E"
                      Content="👁 Mở xem"
                      Padding="10,5"
                      FontSize="11.5"
                      Tag="{Binding}"
                      Click="MoChungTuButton_OnClick"
                      ToolTip.Tip="Mở tài liệu hoặc xem ảnh" />
                    <Button Grid.Column="4"
                      Classes="toolbar-primary"
                      Background="#0A68A7"
                      BorderBrush="#0A68A7"
                      Content="⬇ Tải về"
                      Padding="10,5"
                      FontSize="11.5"
                      Tag="{Binding}"
                      Click="TaiChungTuButton_OnClick"
                      ToolTip.Tip="Lưu file về máy tính" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- 7. GHI CHÚ + NÚT BẤM -->
    <Grid Grid.Row="7"
      ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto"
      ColumnSpacing="10">

      <Border Background="#FFFDF5"
        BorderBrush="#F0E6C8"
        BorderThickness="1"
        CornerRadius="10"
        Padding="14,10"
        IsVisible="{Binding CoGhiChu}">
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="Ghi chú" />
          <TextBlock Text="{Binding GhiChu}"
            TextWrapping="Wrap"
            FontSize="13"
            Foreground="#263B35" />
        </StackPanel>
      </Border>

      <!-- NÚT MUA LẠI / TẠO PHIẾU MỚI TỪ PHIẾU NÀY -->
      <Button Grid.Column="1"
        x:Name="MuaLaiButton"
        Classes="toolbar-primary"
        Background="#087F6E"
        BorderBrush="#087F6E"
        Content="🛒  Mua lại"
        VerticalAlignment="Center"
        ToolTip.Tip="Tạo một phiếu nhập mới sao chép danh sách hàng hóa từ phiếu này"
        Click="MuaLaiButton_OnClick" />

      <!-- NÚT HỦY PHIẾU -->
      <Button Grid.Column="2"
        x:Name="HuyPhieuButton"
        Classes="toolbar-primary"
        Background="#DC2626"
        BorderBrush="#DC2626"
        Content="🚫  Hủy phiếu"
        VerticalAlignment="Center"
        ToolTip.Tip="Hủy phiếu nhập hàng và hoàn tác tồn kho, công nợ"
        Click="HuyPhieuButton_OnClick" />

      <!-- NÚT KHÔI PHỤC PHIẾU -->
      <Button Grid.Column="3"
        x:Name="KhoiPhucPhieuButton"
        Classes="toolbar-primary"
        Background="#2563EB"
        BorderBrush="#2563EB"
        Content="🔄  Khôi phục phiếu"
        VerticalAlignment="Center"
        ToolTip.Tip="Khôi phục lại phiếu nhập đã hủy"
        Click="KhoiPhucPhieuButton_OnClick" />

      <!-- NÚT CHỈNH SỬA PHIẾU -->
      <Button Grid.Column="4"
        x:Name="SuaPhieuButton"
        Classes="toolbar-primary"
        Background="#0A68A7"
        BorderBrush="#0A68A7"
        Content="✏  Chỉnh sửa phiếu"
        VerticalAlignment="Center"
        Click="SuaPhieuButton_OnClick" />

      <!-- NÚT THANH TOÁN CÔNG NỢ -->
      <Button Grid.Column="5"
        x:Name="ThanhToanButton"
        Classes="toolbar-primary"
        Content="💳  Thanh toán công nợ"
        VerticalAlignment="Center"
        Click="ThanhToanButton_OnClick" />

      <!-- NÚT ĐÓNG -->
      <Button Grid.Column="6"
        Classes="toolbar-primary"
        Background="#64748B"
        BorderBrush="#64748B"
        Content="Đóng"
        VerticalAlignment="Center"
        Click="OnCloseClicked" />
    </Grid>
  </Grid>
</Window>
