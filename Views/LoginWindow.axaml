<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShopHoa.ViewModels"
        x:Class="ShopHoa.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"

        Title="SHOP HOA - Đăng nhập"

        Width="1050"
        Height="680"

        MinWidth="950"
        MinHeight="620"

        CanResize="False"
        WindowStartupLocation="CenterScreen"

        Background="#F3F7F5">


    <!-- ========================================================= -->
    <!-- STYLES -->
    <!-- ========================================================= -->

    <Window.Styles>

        <!-- ===================================================== -->
        <!-- TEXTBOX -->
        <!-- ===================================================== -->

        <Style Selector="TextBox.loginInput">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#263B35"/>

            <Setter Property="BorderBrush"
                    Value="#D5E1DD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="14,12"/>

            <Setter Property="MinHeight"
                    Value="48"/>

            <Setter Property="CornerRadius"
                    Value="9"/>

        </Style>


        <Style Selector="TextBox.loginInput:focus">

            <Setter Property="BorderBrush"
                    Value="#078774"/>

            <Setter Property="BorderThickness"
                    Value="1.5"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

        </Style>


        <!-- ===================================================== -->
        <!-- LOGIN BUTTON -->
        <!-- ===================================================== -->

        <Style Selector="Button.loginButton">

            <Setter Property="Background"
                    Value="#087F6E"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="MinHeight"
                    Value="48"/>

            <Setter Property="Padding"
                    Value="18,10"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="CornerRadius"
                    Value="24"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <Style Selector="Button.loginButton:pointerover">

            <Setter Property="Background"
                    Value="#066D5F"/>

        </Style>


        <Style Selector="Button.loginButton:pressed">

            <Setter Property="Background"
                    Value="#05594E"/>

        </Style>


        <!-- ===================================================== -->
        <!-- LINK -->
        <!-- ===================================================== -->

        <Style Selector="Button.linkButton">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#087F6E"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="2,2"/>

        </Style>


        <Style Selector="Button.linkButton:pointerover">

            <Setter Property="Foreground"
                    Value="#05594E"/>

        </Style>


        <!-- ===================================================== -->
        <!-- CHECKBOX -->
        <!-- ===================================================== -->

        <Style Selector="CheckBox">

            <Setter Property="Foreground"
                    Value="#61736D"/>

            <Setter Property="FontSize"
                    Value="12"/>

        </Style>

    </Window.Styles>


    <!-- ========================================================= -->
    <!-- KHUNG NGOÀI -->
    <!-- ========================================================= -->

    <Border Margin="14"
            CornerRadius="20"
            Background="#FFFFFF"
            ClipToBounds="True"

            BoxShadow="0 10 35 #25000000">


        <Grid>


            <!-- ================================================= -->
            <!-- BACKGROUND LOGIN.PNG -->
            <!-- ================================================= -->

            <Image Source="avares://ShopHoa/Assets/Login.png"
                   Stretch="UniformToFill"/>


            <!-- ================================================= -->
            <!-- KHU VỰC FORM BÊN PHẢI -->
            <!-- ================================================= -->

            <Grid HorizontalAlignment="Right"
                  Width="575"

                  Margin="0,0,15,0">


                <!-- ================================================= -->
                <!-- NỀN NHẸ CHO FORM -->
                <!-- ================================================= -->

                <Border Background="#FDFEFC"
                        Opacity="0.94"

                        CornerRadius="18"

                        Margin="0,18,0,18">


                    <Grid Margin="75,28,75,24">


                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- ========================================= -->
                        <!-- LOGO + TIÊU ĐỀ -->
                        <!-- ========================================= -->

                        <StackPanel Grid.Row="0"
                                    HorizontalAlignment="Center">


                            <!-- LOGO -->

                            <Border Width="105"
                                    Height="105"
                                    CornerRadius="53"

                                    Background="#FFFFFF"

                                    HorizontalAlignment="Center">


                                <Image Source="avares://ShopHoa/Assets/Logo.png"

                                       Width="96"
                                       Height="96"

                                       Stretch="Uniform"

                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            </Border>


                            <!-- TIÊU ĐỀ -->

                            <TextBlock Text="Đăng nhập"

                                       FontSize="27"

                                       FontWeight="Bold"

                                       Foreground="#17352E"

                                       HorizontalAlignment="Center"

                                       Margin="0,9,0,0"/>


                            <TextBlock Text="Chào mừng bạn quay trở lại!"

                                       FontSize="12"

                                       Foreground="#87958F"

                                       HorizontalAlignment="Center"

                                       Margin="0,4,0,0"/>


                            <!-- ĐƯỜNG TRANG TRÍ -->

                            <Border Width="38"
                                    Height="3"

                                    Background="#087F6E"

                                    CornerRadius="2"

                                    HorizontalAlignment="Center"

                                    Margin="0,12,0,0"/>

                        </StackPanel>


                        <!-- ========================================= -->
                        <!-- FORM -->
                        <!-- ========================================= -->

                        <StackPanel Grid.Row="1"

                                    Width="390"

                                    HorizontalAlignment="Center"

                                    VerticalAlignment="Center">


                            <!-- TÊN ĐĂNG NHẬP -->

                            <TextBlock Text="Tên đăng nhập"

                                       FontSize="12"

                                       FontWeight="SemiBold"

                                       Foreground="#334640"

                                       Margin="0,0,0,7"/>


                            <TextBox Classes="loginInput"

                                     Text="{Binding TenDangNhap}"

                                     Watermark="Nhập tên đăng nhập"/>


                            <!-- MẬT KHẨU -->

                            <TextBlock Text="Mật khẩu"

                                       FontSize="12"

                                       FontWeight="SemiBold"

                                       Foreground="#334640"

                                       Margin="0,20,0,7"/>


                            <TextBox Classes="loginInput"

                                     PasswordChar="●"

                                     Text="{Binding MatKhau}"

                                     Watermark="Nhập mật khẩu"/>


                            <!-- ================================= -->
                            <!-- GHI NHỚ / QUÊN MẬT KHẨU -->
                            <!-- ================================= -->

                            <Grid Margin="0,12,0,0">


                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <CheckBox Grid.Column="0"

                                          Content="Ghi nhớ đăng nhập"

                                          IsChecked="{Binding GhiNhoDangNhap}"

                                          HorizontalAlignment="Left"/>


                                <Button Grid.Column="1"

                                        Classes="linkButton"

                                        Content="Quên mật khẩu?"

                                        Command="{Binding QuenMatKhauCommand}"

                                        HorizontalAlignment="Right"/>

                            </Grid>


                            <!-- ================================= -->
                            <!-- THÔNG BÁO -->
                            <!-- ================================= -->

                            <TextBlock Text="{Binding ThongBao}"

                                       Foreground="#C94A3D"

                                       FontSize="11"

                                       TextWrapping="Wrap"

                                       MaxWidth="390"

                                       Margin="0,10,0,0"/>


                            <!-- ================================= -->
                            <!-- NÚT ĐĂNG NHẬP -->
                            <!-- ================================= -->

                            <Button Classes="loginButton"

                                    Content="ĐĂNG NHẬP     →"

                                    Command="{Binding DangNhapCommand}"

                                    CommandParameter="{Binding $parent[Window]}"

                                    IsDefault="True"

                                    HorizontalAlignment="Stretch"

                                    Margin="0,18,0,0"/>


                        </StackPanel>


                        <!-- ========================================= -->
                        <!-- FOOTER -->
                        <!-- ========================================= -->

                        <Grid Grid.Row="2">


                            <TextBlock Text="SHOP HOA  •  Quản lý cửa hàng"

                                       FontSize="9"

                                       Foreground="#A1ACA8"

                                       VerticalAlignment="Center"


                                       HorizontalAlignment="Left"/>


                            <StackPanel Orientation="Horizontal"

                                        HorizontalAlignment="Right"


                                        VerticalAlignment="Center">


                                <Ellipse Width="7"
                                         Height="7"

                                         Fill="#20B26B"

                                         VerticalAlignment="Center"/>


                                <TextBlock Text="{Binding TrangThaiKetNoi}"

                                           FontSize="9"

                                           Foreground="#71807A"

                                           Margin="6,0,14,0"

                                           VerticalAlignment="Center"/>


                                <Button Classes="linkButton"

                                        Content="Thoát"

                                        Command="{Binding ThoatCommand}"

                                        CommandParameter="{Binding $parent[Window]}"/>

                            </StackPanel>

                        </Grid>


                    </Grid>

                </Border>


            </Grid>


        </Grid>

    </Border>

</Window>