<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="ShopHoa.Controls.DateInputBox"
  x:Name="Root"
  Height="38"
  Background="Transparent">

  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#163F38" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#E2F0EA" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#F2F7F5" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="ContainerBorder"
    Background="#FFFFFF"
    BorderBrush="#D8E5E0"
    BorderThickness="1"
    CornerRadius="8"
    Padding="8,0"
    VerticalAlignment="Stretch">

    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
      VerticalAlignment="Center">

      <!-- Ô NGÀY -->
      <TextBox x:Name="TxtDay"
        Grid.Column="0"
        Width="30"
        MaxLength="2"
        Watermark="dd" />

      <!-- PHÂN CÁCH / -->
      <TextBlock Grid.Column="1"
        Text="/"
        FontSize="13"
        FontWeight="Medium"
        Foreground="#94A3B8"
        VerticalAlignment="Center"
        Margin="2,0" />

      <!-- Ô THÁNG -->
      <TextBox x:Name="TxtMonth"
        Grid.Column="2"
        Width="30"
        MaxLength="2"
        Watermark="MM" />

      <!-- PHÂN CÁCH / -->
      <TextBlock Grid.Column="3"
        Text="/"
        FontSize="13"
        FontWeight="Medium"
        Foreground="#94A3B8"
        VerticalAlignment="Center"
        Margin="2,0" />

      <!-- Ô NĂM -->
      <TextBox x:Name="TxtYear"
        Grid.Column="4"
        Width="46"
        MaxLength="4"
        Watermark="yyyy" />

    </Grid>
  </Border>
</UserControl>
